---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Favoritos" descripcion="Tu lista de productos favoritos en Propósito UY." noindex>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-bold text-marca-700">Tus favoritos</h1>

    <div id="vacio" class="mt-8 hidden rounded-2xl border border-marca-100 bg-white p-8 text-center">
      <p class="text-marca-900/70">Todavía no guardaste favoritos.</p>
      <p class="mt-1 text-sm text-marca-900/60">Tocá el corazón en cualquier producto para agregarlo acá.</p>
      <a href="/tienda" class="mt-4 inline-block rounded-full bg-marca-600 px-5 py-2.5 font-medium text-white hover:bg-marca-700">
        Ir a la tienda
      </a>
    </div>

    <div id="grid-wrap" class="mt-8 hidden">
      <div id="grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>
    </div>
  </section>
</Layout>

<script>
  import { getFavoritos, quitar, formatoPrecio } from "../scripts/favoritos";

  function render() {
    const grid = document.getElementById("grid");
    const gridWrap = document.getElementById("grid-wrap");
    const vacio = document.getElementById("vacio");
    if (!grid || !gridWrap || !vacio) return;
    const items = getFavoritos();
    vacio.classList.toggle("hidden", items.length > 0);
    gridWrap.classList.toggle("hidden", items.length === 0);

    grid.innerHTML = "";
    for (const i of items) {
      const card = document.createElement("div");
      card.className =
        "group relative flex flex-col overflow-hidden rounded-2xl border border-marca-100 bg-white shadow-sm";
      const img = i.imagen
        ? `<img src="${i.imagen}" alt="${i.nombre}" class="h-full w-full object-cover" />`
        : `<span class="text-sm">Foto pendiente</span>`;
      const desde = i.desde ? `<span class="text-sm font-normal text-marca-500">desde </span>` : "";
      card.innerHTML = `
        <a href="/producto/${i.slug}" class="flex flex-1 flex-col">
          <div class="relative flex aspect-square items-center justify-center bg-marca-50 text-marca-300">${img}</div>
          <div class="flex flex-1 flex-col gap-1 p-4">
            <h3 class="font-semibold text-marca-900">${i.nombre.split(" | ")[0]}</h3>
            <p class="text-sm text-marca-600">${i.variante}</p>
            <p class="mt-2 font-medium text-marca-900">${desde}${formatoPrecio(i.precioDesde)}</p>
          </div>
        </a>
        <button class="quitar absolute right-3 top-3 rounded-full bg-white/90 px-3 py-1.5 text-sm font-medium text-red-600 shadow-sm hover:bg-white">
          Quitar
        </button>
      `;
      card.querySelector(".quitar")!.addEventListener("click", () => {
        quitar(i.slug);
        render();
      });
      grid.appendChild(card);
    }
  }

  document.addEventListener("favoritos:cambio", render);
  document.addEventListener("astro:page-load", render);
</script>
