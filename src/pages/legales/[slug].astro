---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { legales } from "../../data/legales";

const { slug } = Astro.params;
const pagina = legales.find((p) => p.slug === slug);

if (!pagina) {
  return new Response(null, { status: 404, statusText: "Página no encontrada" });
}
---

<Layout titulo={pagina.titulo} descripcion={pagina.resumen}>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-marca-700">{pagina.titulo}</h1>
    <p class="mt-2 text-sm text-marca-500">Última actualización: {pagina.actualizado}</p>

    <div class="mt-8 space-y-8">
      {pagina.bloques.map((b) => (
        <section>
          {b.titulo && <h2 class="text-lg font-semibold text-marca-900">{b.titulo}</h2>}
          {b.parrafos?.map((p) => (
            <p class="mt-2 text-marca-900/80">{p}</p>
          ))}
          {b.lista && (
            <ul class="mt-3 list-disc space-y-1 pl-5 text-marca-900/80">
              {b.lista.map((li) => <li>{li}</li>)}
            </ul>
          )}
        </section>
      ))}
    </div>

    <div class="mt-12 border-t border-marca-100 pt-6">
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {legales
          .filter((p) => p.slug !== pagina.slug)
          .map((p) => (
            <a href={`/legales/${p.slug}`} class="text-marca-700 hover:underline">{p.titulo}</a>
          ))}
      </nav>
    </div>
  </article>
</Layout>
