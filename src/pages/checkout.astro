---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { getClientePorId } from "../lib/cliente-auth";
import { getHorarios } from "../db/queries";

const horarios = await getHorarios();
const sesion = Astro.locals.cliente;
const cliente = sesion ? await getClientePorId(sesion.id) : undefined;
const pre = {
  nombre: cliente?.nombre ?? "",
  celular: cliente?.celular ?? "",
  email: cliente?.email ?? "",
};
const direcciones = cliente?.direcciones ?? [];
---

<Layout titulo="Checkout" descripcion="Finalizá tu pedido en Propósito UY." noindex>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-marca-700">Finalizar pedido</h1>

    <form id="checkout" class="mt-8 grid gap-8 md:grid-cols-[1fr_320px]">
      <!-- Datos y opciones -->
      <div class="space-y-6">
        <fieldset class="rounded-2xl border border-marca-100 bg-white p-5">
          <legend class="px-2 font-semibold text-marca-700">Tus datos</legend>
          {cliente && (
            <p class="mb-3 text-sm text-marca-900/70">Comprando como <strong>{cliente.nombre}</strong> · <a href="/cuenta" class="text-marca-700 hover:underline">Mi cuenta</a></p>
          )}
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="text-sm">Nombre completo
              <input name="nombre" required value={pre.nombre} class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2" /></label>
            <label class="text-sm">Celular
              <input name="celular" required value={pre.celular} class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2" /></label>
            <label class="text-sm sm:col-span-2">Correo electrónico
              <input name="email" type="email" required value={pre.email} class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2" /></label>
          </div>
        </fieldset>

        <fieldset class="rounded-2xl border border-marca-100 bg-white p-5">
          <legend class="px-2 font-semibold text-marca-700">Entrega o retiro</legend>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 text-sm"><input type="radio" name="modalidad" value="entrega" checked /> Entrega a domicilio</label>
            <label class="flex items-center gap-2 text-sm"><input type="radio" name="modalidad" value="retiro" /> Retiro en planta</label>
          </div>
          <label id="campo-direccion" class="mt-3 block text-sm">Dirección
            <input name="direccion" list="direcciones-guardadas" value={direcciones[0] ?? ""} class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2" />
            {direcciones.length > 0 && (
              <datalist id="direcciones-guardadas">
                {direcciones.map((d) => <option value={d}></option>)}
              </datalist>
            )}
          </label>
          <p id="info-retiro" class="mt-3 hidden text-sm text-marca-900/70">
            Retiro en {site.direccionRetiro}. Coordinamos por WhatsApp.
          </p>
        </fieldset>

        <fieldset class="rounded-2xl border border-marca-100 bg-white p-5">
          <legend class="px-2 font-semibold text-marca-700">Agenda</legend>
          <p class="text-sm text-marca-900/60">Elegí un día disponible (trabajamos entregas y retiros los miércoles y viernes) o pedí coordinación personalizada.</p>
          <div id="agenda-dias" class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3"></div>
          <button type="button" id="agenda-coord" class="agenda-opcion mt-2 block w-full rounded-xl border border-marca-300 px-3 py-2 text-left text-sm hover:border-marca-500">
            <span class="font-medium text-marca-700">Coordinación personalizada</span>
            <span class="block text-marca-900/60">Otro día u horario — lo coordinamos por WhatsApp.</span>
          </button>
          <input type="hidden" name="agenda" />
          <input type="hidden" name="fechaAgenda" />
          <p id="agenda-error" class="mt-2 hidden text-sm text-red-600">Elegí una opción de agenda.</p>
          <p
            id="agenda-horario"
            data-retiro={horarios.retiro}
            data-entrega={horarios.entrega}
            class="mt-3 hidden rounded-lg bg-marca-50 p-3 text-sm text-marca-700"
          >
          </p>
        </fieldset>

        <fieldset class="rounded-2xl border border-marca-100 bg-white p-5">
          <legend class="px-2 font-semibold text-marca-700">Método de pago</legend>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 text-sm"><input type="radio" name="metodoPago" value="transferencia" checked /> Transferencia</label>
            <label class="flex items-center gap-2 text-sm"><input type="radio" name="metodoPago" value="efectivo" /> Efectivo</label>
          </div>
        </fieldset>

        <fieldset class="rounded-2xl border border-marca-100 bg-white p-5">
          <legend class="px-2 font-semibold text-marca-700">Notas del pedido</legend>
          <textarea name="notas" rows="3" class="w-full rounded-xl border border-marca-300 px-3 py-2"
            placeholder="Referencias de entrega, retornables, detalle de sabores en Barras Mix, etc."></textarea>
        </fieldset>
      </div>

      <!-- Resumen -->
      <aside class="h-fit rounded-2xl border border-marca-100 bg-white p-5 md:sticky md:top-24">
        <h2 class="font-semibold text-marca-700">Tu pedido</h2>
        <div id="resumen-items" class="mt-3 space-y-2 text-sm"></div>
        <div class="mt-4 space-y-1 border-t border-marca-100 pt-4 text-sm">
          <div class="flex justify-between"><span>Subtotal</span><span id="r-subtotal"></span></div>
          <div class="flex justify-between"><span>Envío</span><span id="r-envio"></span></div>
          <div class="mt-1 flex justify-between text-lg font-bold text-marca-900"><span>Total</span><span id="r-total"></span></div>
        </div>
        <p id="error" class="mt-3 hidden rounded-lg bg-red-50 p-2 text-sm text-red-700"></p>
        <button id="confirmar" type="submit" class="mt-5 w-full rounded-full bg-marca-600 px-5 py-3 font-medium text-white hover:bg-marca-700">
          Confirmar pedido
        </button>
        <a href="/carrito" class="mt-2 block text-center text-sm text-marca-700 hover:underline">Volver al carrito</a>
      </aside>
    </form>
  </section>
</Layout>

<script>
  import { getCarrito, subtotal as calcSubtotal, limpiar, formatoPrecio } from "../scripts/cart";

  const ENVIO = 250;
  const ENVIO_GRATIS_DESDE = 3000;

  function setup() {
  const form = document.getElementById("checkout") as HTMLFormElement | null;
  if (!form) return;
  const itemsEl = document.getElementById("resumen-items")!;
  const errorEl = document.getElementById("error")!;
  const confirmar = document.getElementById("confirmar") as HTMLButtonElement;

  if (getCarrito().length === 0) location.href = "/carrito";

  function modalidad() {
    return (form.querySelector('input[name="modalidad"]:checked') as HTMLInputElement).value;
  }
  function costoEnvio(sub: number) {
    return modalidad() === "retiro" ? 0 : sub >= ENVIO_GRATIS_DESDE ? 0 : ENVIO;
  }

  function render() {
    const items = getCarrito();
    itemsEl.innerHTML = items
      .map((i) => `<div class="flex justify-between"><span>${i.cantidad}× ${i.nombre} <span class="text-marca-500">(${i.presentacion})</span></span><span>${formatoPrecio(i.precio * i.cantidad)}</span></div>`)
      .join("");
    const sub = calcSubtotal();
    const envio = costoEnvio(sub);
    document.getElementById("r-subtotal")!.textContent = formatoPrecio(sub);
    document.getElementById("r-envio")!.textContent = envio === 0 ? "Gratis" : formatoPrecio(envio);
    document.getElementById("r-total")!.textContent = formatoPrecio(sub + envio);
  }

  // Mostrar/ocultar dirección según modalidad
  function toggleModalidad() {
    const esEntrega = modalidad() === "entrega";
    document.getElementById("campo-direccion")!.classList.toggle("hidden", !esEntrega);
    document.getElementById("info-retiro")!.classList.toggle("hidden", esEntrega);
    (form.direccion as HTMLInputElement).required = esEntrega;
    render();
  }
  form.querySelectorAll('input[name="modalidad"]').forEach((r) => r.addEventListener("change", toggleModalidad));

  toggleModalidad(); // inicializa estado (required de dirección, info de retiro) + primer render del resumen

  // ── Agenda: calendario de días habilitados (miércoles y viernes) ──
  const DIAS = ["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"];
  const MESES = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "set", "oct", "nov", "dic"];
  const diasEl = document.getElementById("agenda-dias")!;
  const coordBtn = document.getElementById("agenda-coord")!;
  const agendaError = document.getElementById("agenda-error")!;
  const agendaInput = form.elements.namedItem("agenda") as HTMLInputElement;
  const fechaInput = form.elements.namedItem("fechaAgenda") as HTMLInputElement;
  const horarioEl = document.getElementById("agenda-horario")!;
  const HORARIO = { retiro: horarioEl.dataset.retiro!, entrega: horarioEl.dataset.entrega! };

  // Muestra la franja horaria según la modalidad + el día elegido (PROP-81).
  function updateHorario() {
    const ag = agendaInput.value;
    if (ag === "coordinacion") {
      horarioEl.textContent = "Coordinación personalizada: lo coordinamos por WhatsApp.";
      horarioEl.classList.remove("hidden");
    } else if (ag === "miercoles" || ag === "viernes") {
      const esRetiro = modalidad() === "retiro";
      const lugar = esRetiro ? "Retiro en planta" : "Entrega a domicilio";
      const franja = esRetiro ? HORARIO.retiro : HORARIO.entrega;
      horarioEl.textContent = `${lugar}: ${franja}. Si no te queda bien, elegí "Coordinación personalizada".`;
      horarioEl.classList.remove("hidden");
    } else {
      horarioEl.classList.add("hidden");
    }
  }
  form.querySelectorAll('input[name="modalidad"]').forEach((r) => r.addEventListener("change", updateHorario));

  function proximosDias(cantidad: number) {
    const out: { iso: string; tipo: string; label: string }[] = [];
    const d = new Date();
    d.setHours(0, 0, 0, 0);
    while (out.length < cantidad) {
      d.setDate(d.getDate() + 1);
      const wd = d.getDay();
      if (wd === 3 || wd === 5) {
        const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
        out.push({ iso, tipo: wd === 3 ? "miercoles" : "viernes", label: `${DIAS[wd]} ${d.getDate()} ${MESES[d.getMonth()]}` });
      }
    }
    return out;
  }

  diasEl.innerHTML = proximosDias(6)
    .map(
      (d) =>
        `<button type="button" data-iso="${d.iso}" data-tipo="${d.tipo}" class="agenda-opcion agenda-dia rounded-xl border border-marca-300 px-3 py-2 text-center text-sm hover:border-marca-500"><span class="block font-medium text-marca-700">${d.label}</span></button>`,
    )
    .join("");

  function seleccionar(el: HTMLElement) {
    document
      .querySelectorAll(".agenda-opcion")
      .forEach((b) => b.classList.remove("border-marca-600", "bg-marca-50", "ring-1", "ring-marca-600"));
    el.classList.add("border-marca-600", "bg-marca-50", "ring-1", "ring-marca-600");
    agendaError.classList.add("hidden");
  }

  diasEl.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".agenda-dia") as HTMLButtonElement | null;
    if (!btn) return;
    agendaInput.value = btn.dataset.tipo!;
    fechaInput.value = btn.dataset.iso!;
    seleccionar(btn);
    updateHorario();
  });
  coordBtn.addEventListener("click", () => {
    agendaInput.value = "coordinacion";
    fechaInput.value = "";
    seleccionar(coordBtn);
    updateHorario();
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!agendaInput.value) {
      agendaError.classList.remove("hidden");
      document.getElementById("agenda-dias")!.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }
    errorEl.classList.add("hidden");
    confirmar.disabled = true;
    confirmar.textContent = "Procesando…";

    const fd = new FormData(form);
    const payload = {
      nombre: fd.get("nombre"),
      celular: fd.get("celular"),
      email: fd.get("email"),
      direccion: fd.get("direccion"),
      notas: fd.get("notas"),
      modalidad: fd.get("modalidad"),
      agenda: fd.get("agenda"),
      fechaAgenda: fd.get("fechaAgenda") || null,
      metodoPago: fd.get("metodoPago"),
      items: getCarrito().map((i) => ({ slug: i.slug, presentacion: i.presentacion, cantidad: i.cantidad, mix: i.mix })),
    };

    try {
      const res = await fetch("/api/pedidos", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "No se pudo crear el pedido.");
      limpiar();
      location.href = `/pedido/${data.numero}`;
    } catch (err: any) {
      errorEl.textContent = err.message;
      errorEl.classList.remove("hidden");
      confirmar.disabled = false;
      confirmar.textContent = "Confirmar pedido";
    }
  });
  }

  document.addEventListener("astro:page-load", setup);
</script>
