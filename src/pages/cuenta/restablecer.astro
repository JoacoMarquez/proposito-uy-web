---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { validarReset, consumirReset } from "../../lib/password-reset";

const token = Astro.url.searchParams.get("token") ?? "";
let error = "";
let listo = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const pass = String(form.get("password") ?? "");
  const pass2 = String(form.get("password2") ?? "");
  if (pass !== pass2) {
    error = "Las contraseñas no coinciden.";
  } else {
    const res = await consumirReset(token, pass);
    if (res.error) error = res.error;
    else listo = true;
  }
}

// Si no se acaba de cambiar, validamos el token para mostrar el form o el error.
const valido = listo || (await validarReset(token)) != null;
---

<Layout titulo="Nueva contraseña" descripcion="Creá tu nueva contraseña." noindex>
  <section class="mx-auto max-w-sm px-4 py-12">
    <h1 class="text-2xl font-bold text-marca-700">Nueva contraseña</h1>

    {listo ? (
      <div class="mt-6 rounded-xl bg-marca-50 p-4 text-sm text-marca-900/80">
        <p>¡Listo! Tu contraseña se actualizó. Ya podés ingresar.</p>
        <a href="/cuenta/login" class="mt-3 inline-block font-medium text-marca-700 hover:underline">Ir a ingresar →</a>
      </div>
    ) : !valido ? (
      <div class="mt-6 rounded-xl bg-red-50 p-4 text-sm text-red-700">
        <p>El enlace no es válido o ya venció.</p>
        <a href="/cuenta/recuperar" class="mt-3 inline-block font-medium text-marca-700 hover:underline">Pedir un nuevo enlace</a>
      </div>
    ) : (
      <>
        {error && <p class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700">{error}</p>}
        <form method="POST" class="mt-6 space-y-4">
          <label class="block text-sm font-medium text-marca-700">Nueva contraseña
            <input type="password" name="password" required minlength="6" autocomplete="new-password"
              class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2" /></label>
          <label class="block text-sm font-medium text-marca-700">Repetir contraseña
            <input type="password" name="password2" required minlength="6" autocomplete="new-password"
              class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2" /></label>
          <button type="submit" class="w-full rounded-full bg-marca-600 py-2.5 font-medium text-white hover:bg-marca-700">Guardar contraseña</button>
        </form>
      </>
    )}
  </section>
</Layout>
