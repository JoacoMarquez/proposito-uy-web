---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { crearReset, htmlMailReset } from "../../lib/password-reset";
import { enviarMailBrevo } from "../../lib/brevo";

let enviado = false;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const email = String(form.get("email") ?? "").trim().toLowerCase();
  if (email) {
    const token = await crearReset("cliente", email);
    if (token) {
      const link = `${Astro.url.origin}/cuenta/restablecer?token=${token}`;
      await enviarMailBrevo({
        to: email,
        subject: "Restablecer tu contraseña · Propósito UY",
        html: htmlMailReset(link),
      }).catch(() => {});
    }
  }
  enviado = true; // mensaje genérico siempre (no revelamos si el email existe)
}
---

<Layout titulo="Recuperar contraseña" descripcion="Restablecé tu contraseña." noindex>
  <section class="mx-auto max-w-sm px-4 py-12">
    <h1 class="text-2xl font-bold text-marca-700">¿Olvidaste tu contraseña?</h1>
    {enviado ? (
      <div class="mt-6 rounded-xl bg-marca-50 p-4 text-sm text-marca-900/80">
        <p>Si hay una cuenta con ese email, te enviamos un enlace para crear una nueva contraseña. Revisá tu casilla (y el spam).</p>
        <a href="/cuenta/login" class="mt-3 inline-block font-medium text-marca-700 hover:underline">← Volver a ingresar</a>
      </div>
    ) : (
      <>
        <p class="mt-2 text-sm text-marca-900/70">Ingresá tu email y te mandamos un enlace para restablecerla.</p>
        <form method="POST" class="mt-6 space-y-4">
          <label class="block text-sm font-medium text-marca-700">Email
            <input type="email" name="email" required autocomplete="username"
              class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2" /></label>
          <button type="submit" class="w-full rounded-full bg-marca-600 py-2.5 font-medium text-white hover:bg-marca-700">Enviar enlace</button>
        </form>
        <a href="/cuenta/login" class="mt-4 inline-block text-sm font-medium text-marca-700 hover:underline">← Volver a ingresar</a>
      </>
    )}
  </section>
</Layout>
