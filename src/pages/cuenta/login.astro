---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { loginCliente, crearSesionCliente, CLIENTE_COOKIE } from "../../lib/cliente-auth";

if (Astro.locals.cliente) return Astro.redirect("/cuenta");

let error = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const email = String(form.get("email") ?? "");
  const password = String(form.get("password") ?? "");
  const cliente = await loginCliente(email, password);
  if (cliente) {
    const { token, expira } = await crearSesionCliente(cliente.id);
    Astro.cookies.set(CLIENTE_COOKIE, token, {
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: "lax",
      path: "/",
      expires: expira,
    });
    return Astro.redirect("/cuenta");
  }
  error = "Email o contraseña incorrectos.";
}
---

<Layout titulo="Ingresar" descripcion="Ingresá a tu cuenta de Propósito UY.">
  <section class="mx-auto max-w-sm px-4 py-12">
    <h1 class="text-2xl font-bold text-marca-700">Ingresar</h1>
    {error && <p class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700">{error}</p>}
    <form method="POST" class="mt-6 space-y-4">
      <label class="block text-sm font-medium text-marca-700">Email
        <input type="email" name="email" required autocomplete="username"
          class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2" /></label>
      <label class="block text-sm font-medium text-marca-700">Contraseña
        <input type="password" name="password" required autocomplete="current-password"
          class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2" /></label>
      <button type="submit" class="w-full rounded-full bg-marca-600 py-2.5 font-medium text-white hover:bg-marca-700">Ingresar</button>
    </form>
    <p class="mt-4 text-center text-sm text-marca-900/70">¿No tenés cuenta?
      <a href="/cuenta/registro" class="font-medium text-marca-700 hover:underline">Registrate</a>
    </p>
  </section>
</Layout>
