---
export const prerender = false;
// Editor de producto, compartido por Tienda (/admin/productos/[id]) y Cultivo
// (/admin/cultivo/[id]). En Cultivo los campos informativos cambian según el
// tipo de la categoría elegida (Plantines / Insumos / Cosechas).
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminEditorHeader from "../../../components/AdminEditorHeader.astro";
import ImageField from "../../../components/ImageField.astro";
import {
  getProductoById,
  getProductosSeccion,
  getCategorias,
  getCategoria,
  upsertProducto,
  deleteProducto,
  type ProductoInput,
} from "../../../db/queries";
import { procesarImagenSubida } from "../../../lib/upload";
import { seccionAdmin, baseAdmin } from "../../../lib/admin-seccion";
import {
  ESPECIFICACIONES,
  TIPOS_CULTIVO,
  PRESENTACIONES_INICIALES,
  limpiarEspecificaciones,
  titulosEditables,
  claveTitulo,
  esTipoCultivo,
} from "../../../lib/cultivo";

const sec = seccionAdmin(Astro.params.seccion);
if (!sec) return Astro.redirect("/admin");
const esCultivo = sec.seccion === "cultivo";

const { id: idParam } = Astro.params;
const esNuevo = idParam === "nuevo";
const id = esNuevo ? null : Number(idParam);

if (!esNuevo && (!id || Number.isNaN(id))) return Astro.redirect(sec.base);

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();

  if (form.get("_action") === "delete" && id) {
    await deleteProducto(id);
    return Astro.redirect(sec.base);
  }

  const s = (k: string) => String(form.get(k) ?? "").trim();
  const sn = (k: string) => (s(k) === "" ? null : s(k));

  const labels = form.getAll("pres_label").map((x) => String(x).trim());
  const precios = form.getAll("pres_precio").map((x) => String(x).trim());
  const frascos = form.getAll("pres_frascos").map((x) => String(x).trim());
  const pres = labels
    .map((label, i) => {
      const n = parseInt(frascos[i] ?? "", 10);
      return {
        label,
        precio: Number(precios[i]),
        frascosGratis: !esCultivo && Number.isFinite(n) && n > 0 ? n : null,
      };
    })
    .filter((p) => p.label !== "" && Number.isFinite(p.precio) && p.precio > 0);

  // Imagen: si se subió un archivo nuevo, se guarda y se usa su URL; si no,
  // se conserva la actual (campo oculto `imagen`).
  const subida = await procesarImagenSubida(form);
  const subida2 = await procesarImagenSubida(form, "imagen2File");

  // La categoría tiene que ser de esta sección (no se puede mover un producto
  // de Tienda a Cultivo desde acá ni al revés).
  const cat = s("categoriaSlug") ? await getCategoria(s("categoriaSlug")) : undefined;
  const catValida = cat && cat.seccion === sec.seccion;

  // Cultivo: las tarjetas vienen con prefijo por tipo (esp_<tipo>_<clave>) para
  // que no choquen entre tipos; se toman solo las del tipo de la categoría. En
  // Insumos también llega el título de cada tarjeta (esp_insumos_titulo_<clave>).
  const especificaciones: Record<string, string> = {};
  if (esCultivo && esTipoCultivo(cat?.tipo)) {
    for (const c of ESPECIFICACIONES[cat.tipo]) {
      especificaciones[c.key] = s(`esp_${cat.tipo}_${c.key}`);
      if (titulosEditables(cat.tipo)) {
        especificaciones[claveTitulo(c.key)] = s(`esp_${cat.tipo}_${claveTitulo(c.key)}`);
      }
    }
  }

  const data: ProductoInput = {
    slug: s("slug"),
    nombre: s("nombre"),
    variante: s("variante"),
    categoriaSlug: s("categoriaSlug"),
    descripcion: s("descripcion"),
    textoInformativo: esCultivo ? null : sn("textoInformativo"),
    proteina: esCultivo ? null : sn("proteina"),
    ingredientes: esCultivo ? "" : s("ingredientes"),
    packaging: esCultivo ? "" : s("packaging"),
    conservacion: esCultivo ? "" : s("conservacion"),
    uso: esCultivo ? null : sn("uso"),
    vencimiento: esCultivo ? "" : s("vencimiento"),
    tamanoUnitario: esCultivo ? null : sn("tamanoUnitario"),
    contenido: esCultivo ? null : sn("contenido"),
    nota: sn("nota"),
    productoAliadoSlug: sn("productoAliadoSlug"),
    // "Los más pedidos" es solo de la Tienda.
    destacado: !esCultivo && form.get("destacado") === "on",
    disponible: form.get("disponible") === "on",
    imagen: subida.url ?? sn("imagen"),
    imagen2: subida2.url ?? sn("imagen2"),
    ...(esCultivo ? { especificaciones: limpiarEspecificaciones(cat?.tipo, especificaciones) } : {}),
  };

  if (subida.error || subida2.error) {
    error = subida.error ?? subida2.error ?? "";
  } else if (!data.slug || !data.nombre || !data.variante || !data.categoriaSlug) {
    error = "Completá al menos slug, nombre, variante y categoría.";
  } else if (!catValida) {
    error = "Elegí una categoría válida.";
  } else if (pres.length === 0) {
    error = "Agregá al menos una presentación con precio.";
  }
  if (Astro.request.method === "POST" && !error) {
    try {
      const nuevoId = await upsertProducto(id, data, pres);
      return Astro.redirect(`${sec.base}/${nuevoId}?ok=1`);
    } catch (e: any) {
      const dup = e?.code === "23505" || /unique|duplicad|duplicate/i.test(String(e?.message ?? ""));
      if (!dup) throw e;
      error = "Ya existe otro producto con ese slug (URL). Elegí uno distinto.";
    }
  }
}

const guardado = Astro.url.searchParams.get("ok") === "1";

const producto = id ? await getProductoById(id) : undefined;
if (!esNuevo && !producto) return Astro.redirect(sec.base);

const [cats, todos] = await Promise.all([getCategorias(sec.seccion), getProductosSeccion(sec.seccion)]);
const p = producto;

// Producto de la otra sección abierto con la URL equivocada → ir a la correcta.
if (p && !cats.some((c) => c.slug === p.categoriaSlug)) {
  const real = await getCategoria(p.categoriaSlug);
  return Astro.redirect(`${baseAdmin(real?.seccion)}/${p.id}`);
}

// Categoría preseleccionada: la del producto, la de ?categoria= (desde el
// editor de categoría) o la primera.
const catInicial = p?.categoriaSlug ?? Astro.url.searchParams.get("categoria") ?? cats[0]?.slug;
const tipoInicial = cats.find((c) => c.slug === catInicial)?.tipo ?? null;

// Presentaciones: existentes + filas vacías. Un producto nuevo de Plantines
// arranca con las bolsas de vivero de 2 y 5 L (consigna de Pedro).
const presIniciales =
  esNuevo && esCultivo && esTipoCultivo(tipoInicial)
    ? (PRESENTACIONES_INICIALES[tipoInicial] ?? []).map((label) => ({ label, precio: 0 }))
    : (p?.presentaciones ?? []);
const filasPres = [...presIniciales, { label: "", precio: 0 }, { label: "", precio: 0 }];
const esp = p?.especificaciones ?? {};

const campoBase = "mt-1 w-full rounded-xl border border-marca-300 px-3 py-2 text-sm";
const tituloLista = esCultivo ? "Cultivo" : "productos";
---

<AdminLayout titulo={esNuevo ? "Nuevo producto" : `Editar: ${p?.nombre} | ${p?.variante}`} ocultarTitulo>
  <AdminEditorHeader
    slot="antetitulo"
    titulo={esNuevo ? (esCultivo ? "Nuevo producto de Cultivo" : "Nuevo producto") : `${p?.nombre} | ${p?.variante}`}
    volverHref={sec.base}
    volverLabel={`Volver a ${tituloLista}`}
    formId="editor-producto"
    guardado={guardado}
  >
    {!esNuevo && (
      <form slot="acciones" method="POST">
        <input type="hidden" name="_action" value="delete" />
        <button
          type="submit"
          onclick="return confirm('¿Eliminar este producto?')"
          class="rounded-full border border-red-300 px-4 py-2 text-sm font-medium text-red-600 transition hover:bg-red-50"
        >
          Eliminar
        </button>
      </form>
    )}
  </AdminEditorHeader>

  {error && <p class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700">{error}</p>}

  <form id="editor-producto" method="POST" enctype="multipart/form-data" class="max-w-3xl space-y-5" data-tipo-actual={tipoInicial ?? ""}>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="text-sm font-medium text-marca-700">Nombre</label>
        <input name="nombre" value={p?.nombre ?? ""} required class={campoBase} />
      </div>
      <div>
        <label class="text-sm font-medium text-marca-700">Variante</label>
        <input name="variante" value={p?.variante ?? ""} required class={campoBase} placeholder={esCultivo ? "Ej: Aromática, Campo, Guía" : ""} />
      </div>
      <div>
        <label class="text-sm font-medium text-marca-700">Slug (URL)</label>
        <input name="slug" value={p?.slug ?? ""} required class={campoBase} />
      </div>
      <div>
        <label class="text-sm font-medium text-marca-700">Categoría</label>
        <select name="categoriaSlug" class={campoBase} data-categoria>
          {cats.map((c) => (
            <option value={c.slug} data-tipo={c.tipo ?? ""} selected={catInicial === c.slug}>{c.nombre}</option>
          ))}
        </select>
      </div>
    </div>

    <div>
      <label class="text-sm font-medium text-marca-700">Descripción</label>
      <textarea name="descripcion" rows="2" class={campoBase}>{p?.descripcion ?? ""}</textarea>
    </div>

    <!-- Imagen -->
    <ImageField imagen={p?.imagen} alt={p?.nombre ?? "imagen"} label="Imagen principal" />
    <ImageField imagen={p?.imagen2} alt={p?.nombre ?? "imagen"} name="imagen2" fieldId="imagen2File" label="Imagen secundaria" />

    <!-- Presentaciones -->
    <div>
      <label class="text-sm font-medium text-marca-700">Presentaciones y precios</label>
      {esCultivo ? (
        <p class="text-xs text-marca-500">
          Label y precio en pesos. Ej: 2 L, 25 litros, Atado, 1 kg, Unidad. Dejá vacío para omitir.
        </p>
      ) : (
        <p class="text-xs text-marca-500">
          Label (ej: ½ kg, x12) y precio en pesos. Dejá vacío para omitir.
          <br />
          Barras: anteponé S o L al label (ej: S x12, L x12) y la ficha muestra el selector Barra S (40 g) / Barra L (80 g).
          <br />
          “Frascos p/ 1 gratis”: cantidad de envases a devolver para recibir 1 unidad gratis (retornables). Dejalo vacío si la presentación no participa.
        </p>
      )}
      <div class="mt-2 space-y-2">
        {filasPres.map((pr) => (
          <div class="flex gap-2">
            <input name="pres_label" value={pr.label} placeholder="Label" class="flex-1 rounded-xl border border-marca-300 px-3 py-2 text-sm" />
            <input name="pres_precio" value={pr.precio || ""} type="number" placeholder="Precio" class="w-32 rounded-xl border border-marca-300 px-3 py-2 text-sm" />
            {!esCultivo && (
              <input name="pres_frascos" value={("frascosGratis" in pr && pr.frascosGratis) || ""} type="number" min="1" placeholder="Frascos p/ gratis" class="w-32 rounded-xl border border-marca-300 px-3 py-2 text-sm" title="Frascos a devolver para 1 gratis (retornables)" />
            )}
          </div>
        ))}
      </div>
    </div>

    {esCultivo ? (
      <Fragment>
        <!-- Tarjetas informativas: un grupo por tipo, se muestra el de la categoría elegida -->
        {TIPOS_CULTIVO.map((tipo) => (
          <div data-grupo-tipo={tipo} hidden={tipo !== tipoInicial}>
            <p class="text-sm font-medium text-marca-700">Tarjetas informativas</p>
            <p class="text-xs text-marca-500">
              Las seis tarjetas de la ficha. Las que quedan vacías no se muestran.
              {titulosEditables(tipo) && " En Insumos podés cambiar también el título de cada tarjeta."}
            </p>
            <div class="mt-2 grid gap-4 sm:grid-cols-2">
              {ESPECIFICACIONES[tipo].map((c) => (
                <div>
                  {titulosEditables(tipo) ? (
                    <input
                      name={`esp_${tipo}_${claveTitulo(c.key)}`}
                      value={(tipo === tipoInicial ? esp[claveTitulo(c.key)] : "") || c.label}
                      aria-label={`Título de la tarjeta (${c.label})`}
                      class="w-full rounded-lg border border-dashed border-marca-300 bg-marca-50 px-2 py-1 text-sm font-medium text-marca-700"
                    />
                  ) : (
                    <label class="text-sm font-medium text-marca-700">{c.label}</label>
                  )}
                  <textarea name={`esp_${tipo}_${c.key}`} rows="2" class={campoBase} placeholder={c.ayuda ?? ""}>{tipo === tipoInicial ? (esp[c.key] ?? "") : ""}</textarea>
                </div>
              ))}
            </div>
          </div>
        ))}

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="text-sm font-medium text-marca-700">Nota</label>
            <input name="nota" value={p?.nota ?? ""} class={campoBase} />
          </div>
          <div>
            <label class="text-sm font-medium text-marca-700">Producto aliado</label>
            <select name="productoAliadoSlug" class={campoBase}>
              <option value="">— ninguno —</option>
              {todos.filter((x) => x.id !== p?.id).map((x) => (
                <option value={x.slug} selected={p?.productoAliadoSlug === x.slug}>{x.nombre} | {x.variante}</option>
              ))}
            </select>
          </div>
        </div>
      </Fragment>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="text-sm font-medium text-marca-700">Ingredientes</label>
          <textarea name="ingredientes" rows="2" class={campoBase}>{p?.ingredientes ?? ""}</textarea>
        </div>
        <div>
          <label class="text-sm font-medium text-marca-700">Texto informativo (ej: congelado)</label>
          <textarea name="textoInformativo" rows="2" class={campoBase}>{p?.textoInformativo ?? ""}</textarea>
        </div>
        <div>
          <label class="text-sm font-medium text-marca-700">Proteína (distintivo)</label>
          <input name="proteina" value={p?.proteina ?? ""} placeholder="Ej: 10 g de proteína" class={campoBase} title="Se muestra como distintivo en la ficha del producto, igual que el de retornable. Dejalo vacío para no mostrarlo." />
        </div>
        <div>
          <label class="text-sm font-medium text-marca-700">Packaging</label>
          <input name="packaging" value={p?.packaging ?? ""} class={campoBase} />
        </div>
        <div>
          <label class="text-sm font-medium text-marca-700">Conservación</label>
          <input name="conservacion" value={p?.conservacion ?? ""} class={campoBase} />
        </div>
        <div>
          <label class="text-sm font-medium text-marca-700">Uso</label>
          <input name="uso" value={p?.uso ?? ""} class={campoBase} />
        </div>
        <div>
          <label class="text-sm font-medium text-marca-700">Vencimiento</label>
          <input name="vencimiento" value={p?.vencimiento ?? ""} class={campoBase} />
        </div>
        <div>
          <label class="text-sm font-medium text-marca-700">Tamaño unitario</label>
          <input name="tamanoUnitario" value={p?.tamanoUnitario ?? ""} class={campoBase} />
        </div>
        <div>
          <label class="text-sm font-medium text-marca-700">Contenido (cajas)</label>
          <input name="contenido" value={p?.contenido ?? ""} class={campoBase} />
        </div>
        <div>
          <label class="text-sm font-medium text-marca-700">Nota</label>
          <input name="nota" value={p?.nota ?? ""} class={campoBase} />
        </div>
        <div>
          <label class="text-sm font-medium text-marca-700">Producto aliado</label>
          <select name="productoAliadoSlug" class={campoBase}>
            <option value="">— ninguno —</option>
            {todos.filter((x) => x.id !== p?.id).map((x) => (
              <option value={x.slug} selected={p?.productoAliadoSlug === x.slug}>{x.nombre} | {x.variante}</option>
            ))}
          </select>
        </div>
      </div>
    )}

    <div class="flex gap-6">
      {!esCultivo && (
        <label class="flex items-center gap-2 text-sm text-marca-700">
          <input type="checkbox" name="destacado" checked={p?.destacado ?? false} /> Destacado (más pedidos)
        </label>
      )}
      <label class="flex items-center gap-2 text-sm text-marca-700">
        <input type="checkbox" name="disponible" checked={p?.disponible ?? true} /> Disponible
      </label>
    </div>
  </form>
</AdminLayout>

<script>
  // Cultivo: al cambiar la categoría se muestran las tarjetas de su tipo.
  function setupTipos() {
    const form = document.getElementById("editor-producto");
    const sel = form?.querySelector<HTMLSelectElement>("[data-categoria]");
    const grupos = form ? [...form.querySelectorAll<HTMLElement>("[data-grupo-tipo]")] : [];
    if (!sel || grupos.length === 0) return;
    const aplicar = () => {
      const tipo = sel.selectedOptions[0]?.dataset.tipo ?? "";
      grupos.forEach((g) => (g.hidden = g.dataset.grupoTipo !== tipo));
    };
    sel.addEventListener("change", aplicar);
    aplicar();
  }
  setupTipos();
  document.addEventListener("astro:after-swap", setupTipos);
</script>
