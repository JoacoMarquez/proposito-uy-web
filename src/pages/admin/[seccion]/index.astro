---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getProductosSeccion, getCategorias, precioDesde, formatoPrecio } from "../../../db/queries";
import { seccionAdmin } from "../../../lib/admin-seccion";

const sec = seccionAdmin(Astro.params.seccion);
if (!sec) return Astro.redirect("/admin");
const [productos, cats] = await Promise.all([getProductosSeccion(sec.seccion), getCategorias(sec.seccion)]);
const nombreCat = (slug: string) => cats.find((c) => c.slug === slug)?.nombre ?? slug;
---

<AdminLayout titulo={sec.titulo}>
  <div class="mb-4 flex flex-wrap justify-end gap-2">
    <a href={`${sec.base}/ordenar`} class="rounded-full border border-marca-300 px-4 py-2 text-sm font-medium text-marca-700 hover:bg-marca-50">
      Ordenar catálogo
    </a>
    {sec.seccion === "tienda" && (
      <a href="/admin/productos/destacados" class="rounded-full border border-marca-300 px-4 py-2 text-sm font-medium text-marca-700 hover:bg-marca-50">
        Ordenar “Los más pedidos”
      </a>
    )}
    <a href={`${sec.base}/nuevo`} class="rounded-full bg-marca-600 px-4 py-2 text-sm font-medium text-white hover:bg-marca-700">
      + Nuevo producto
    </a>
  </div>

  <div class="overflow-hidden rounded-2xl border border-marca-100 bg-white">
    <table class="w-full text-sm">
      <thead class="border-b border-marca-100 bg-marca-50 text-left text-marca-700">
        <tr>
          <th class="p-3">Producto</th>
          <th class="p-3">Categoría</th>
          <th class="p-3">Desde</th>
          <th class="p-3">Estado</th>
          <th class="p-3"></th>
        </tr>
      </thead>
      <tbody>
        {productos.length === 0 && (
          <tr><td colspan="5" class="p-6 text-center text-marca-500">Todavía no hay productos. Creá el primero con “+ Nuevo producto”.</td></tr>
        )}
        {productos.map((p) => (
          <tr class="border-b border-marca-50 last:border-0">
            <td class="p-3">
              <div class="flex items-center gap-3">
                {p.imagen
                  ? <img src={p.imagen} alt={p.nombre} class="h-10 w-10 shrink-0 rounded-lg border border-marca-100 object-cover" />
                  : <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-marca-100 bg-marca-50 text-marca-300" aria-hidden="true">🖼️</div>}
                <div>
                  <span class="font-medium text-marca-900">{p.nombre}</span>
                  <span class="text-marca-500"> | {p.variante}</span>
                  {p.destacado && <span class="ml-2 rounded-full bg-marca-100 px-2 py-0.5 text-xs">★ destacado</span>}
                </div>
              </div>
            </td>
            <td class="p-3 text-marca-900/70">{nombreCat(p.categoriaSlug)}</td>
            <td class="p-3">{p.presentaciones.length ? formatoPrecio(precioDesde(p)) : "—"}</td>
            <td class="p-3">
              {p.disponible
                ? <span class="text-marca-600">Disponible</span>
                : <span class="text-red-600">Agotado</span>}
            </td>
            <td class="p-3 text-right">
              <a href={`${sec.base}/${p.id}`} class="font-medium text-marca-700 hover:underline">Editar</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
