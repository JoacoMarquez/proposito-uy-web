---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getPreguntas } from "../../../db/queries";

const preguntas = await getPreguntas();
const temaLabel: Record<string, string> = {
  pedidos: "Pedidos",
  elaboracion: "Elaboración",
  nutricional: "Nutricional",
};
---

<AdminLayout titulo="Preguntas frecuentes">
  <div class="mb-4 flex justify-end">
    <a href="/admin/preguntas/nuevo" class="rounded-full bg-marca-600 px-4 py-2 text-sm font-medium text-white hover:bg-marca-700">
      + Nueva pregunta
    </a>
  </div>

  <div class="overflow-hidden rounded-2xl border border-marca-100 bg-white">
    <table class="w-full text-sm">
      <thead class="border-b border-marca-100 bg-marca-50 text-left text-marca-700">
        <tr>
          <th class="p-3">Pregunta</th>
          <th class="p-3">Tema</th>
          <th class="p-3">Orden</th>
          <th class="p-3"></th>
        </tr>
      </thead>
      <tbody>
        {preguntas.length === 0 && (
          <tr><td colspan="4" class="p-4 text-center text-marca-900/60">Todavía no hay preguntas cargadas.</td></tr>
        )}
        {preguntas.map((p) => (
          <tr class="border-b border-marca-50 last:border-0">
            <td class="p-3 font-medium text-marca-900">{p.pregunta}</td>
            <td class="p-3 text-marca-900/70">{temaLabel[p.tema] ?? p.tema}</td>
            <td class="p-3 text-marca-900/70">{p.orden}</td>
            <td class="p-3 text-right">
              <a href={`/admin/preguntas/${p.id}`} class="font-medium text-marca-700 hover:underline">Editar</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
