---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import {
  getProductos,
  getCategorias,
  actualizarOrdenCategoria,
  precioDesde,
  formatoPrecio,
} from "../../../db/queries";

// Guardado del nuevo orden de una categoría (llega por fetch desde el arrastre).
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  try {
    const ids = JSON.parse(String(form.get("orden") ?? "[]"));
    if (Array.isArray(ids)) await actualizarOrdenCategoria(ids.map(Number));
  } catch {
    // ignora payload inválido
  }
  return new Response(null, { status: 204 });
}

const [productos, cats] = await Promise.all([getProductos(), getCategorias()]);
// Productos agrupados por categoría, ya ordenados por `ordenCategoria`.
const grupos = cats.map((c) => ({
  cat: c,
  items: productos
    .filter((p) => p.categoriaSlug === c.slug)
    .sort((a, b) => a.ordenCategoria - b.ordenCategoria),
}));
---

<AdminLayout titulo="Ordenar catálogo">
  <div class="mb-4 flex items-center justify-between">
    <p class="text-sm text-marca-500">Arrastrá las filas para reordenar cómo se ven los productos dentro de cada categoría en la tienda. El orden se guarda solo.</p>
    <a href="/admin/productos" class="text-sm font-medium text-marca-700 hover:underline">← Productos</a>
  </div>

  <div class="space-y-8">
    {grupos.map((g) => (
      <div>
        <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-marca-700">{g.cat.nombre}</h2>
        {g.items.length === 0 ? (
          <div class="rounded-2xl border border-marca-100 bg-white p-6 text-sm text-marca-500">
            No hay productos en esta categoría.
          </div>
        ) : (
          <div class="overflow-hidden rounded-2xl border border-marca-100 bg-white">
            <table class="w-full text-sm">
              <thead class="border-b border-marca-100 bg-marca-50 text-left text-marca-700">
                <tr>
                  <th class="w-10 p-3"></th>
                  <th class="w-16 p-3">Orden</th>
                  <th class="p-3">Producto</th>
                  <th class="p-3">Desde</th>
                  <th class="p-3"></th>
                </tr>
              </thead>
              <tbody data-orden-body data-cat={g.cat.slug}>
                {g.items.map((p, i) => (
                  <tr class="border-b border-marca-50 last:border-0" draggable="true" data-id={p.id}>
                    <td class="cursor-move select-none p-3 text-center text-marca-300" data-drag-handle title="Arrastrar para reordenar">⠿</td>
                    <td class="p-3 text-marca-900/70" data-orden>{i + 1}</td>
                    <td class="p-3">
                      <div class="flex items-center gap-3">
                        {p.imagen
                          ? <img src={p.imagen} alt={p.nombre} class="h-10 w-10 shrink-0 rounded-lg border border-marca-100 object-cover" />
                          : <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-marca-100 bg-marca-50 text-marca-300" aria-hidden="true">🖼️</div>}
                        <div>
                          <span class="font-medium text-marca-900">{p.nombre}</span>
                          <span class="text-marca-500"> | {p.variante}</span>
                          {!p.disponible && <span class="ml-2 rounded-full bg-red-50 px-2 py-0.5 text-xs text-red-600">agotado</span>}
                        </div>
                      </div>
                    </td>
                    <td class="p-3">{p.presentaciones.length ? formatoPrecio(precioDesde(p)) : "—"}</td>
                    <td class="p-3 text-right">
                      <a href={`/admin/productos/${p.id}`} class="font-medium text-marca-700 hover:underline">Editar</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    ))}
  </div>
</AdminLayout>

<script>
  function setupOrden() {
    const tablas = document.querySelectorAll<HTMLElement>("[data-orden-body]");
    tablas.forEach((tbody) => {
      if (tbody.dataset.init) return;
      tbody.dataset.init = "1";
      let dragged: HTMLElement | null = null;

      tbody.querySelectorAll<HTMLElement>("tr").forEach((tr) => {
        tr.addEventListener("dragstart", () => {
          dragged = tr;
          setTimeout(() => tr.classList.add("opacity-40"), 0);
        });
        tr.addEventListener("dragend", () => {
          tr.classList.remove("opacity-40");
          guardar();
        });
        tr.addEventListener("dragover", (e) => {
          e.preventDefault();
          if (!dragged || dragged === tr) return;
          const r = tr.getBoundingClientRect();
          const despues = e.clientY > r.top + r.height / 2;
          tbody.insertBefore(dragged, despues ? tr.nextSibling : tr);
        });
      });

      async function guardar() {
        const filas = [...tbody.querySelectorAll<HTMLElement>("tr")];
        const ids = filas.map((tr) => Number(tr.dataset.id));
        filas.forEach((tr, i) => {
          const celda = tr.querySelector("[data-orden]");
          if (celda) celda.textContent = String(i + 1);
        });
        await fetch(location.pathname, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: "orden=" + encodeURIComponent(JSON.stringify(ids)),
        });
      }
    });
  }
  setupOrden();
  document.addEventListener("astro:after-swap", setupOrden);
</script>
