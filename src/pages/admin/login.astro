---
export const prerender = false;
import "../../styles/global.css";
import { eq } from "drizzle-orm";
import { db } from "../../db";
import { adminUsers } from "../../db/schema";
import { verifyPassword, createSession, SESSION_COOKIE } from "../../lib/auth";

let error = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const email = String(form.get("email") ?? "").trim().toLowerCase();
  const password = String(form.get("password") ?? "");
  const [u] = await db.select().from(adminUsers).where(eq(adminUsers.email, email)).limit(1);
  if (u && (await verifyPassword(password, u.passwordHash))) {
    const { token, expira } = await createSession(u.id);
    Astro.cookies.set(SESSION_COOKIE, token, {
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: "lax",
      path: "/",
      expires: expira,
    });
    return Astro.redirect("/admin");
  }
  error = "Email o contraseña incorrectos.";
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ingresar · Admin Propósito UY</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-crema font-sans">
    <form method="POST" class="w-full max-w-sm rounded-2xl border border-marca-100 bg-white p-8 shadow-sm">
      <p class="text-lg font-bold text-marca-700">Propósito UY</p>
      <h1 class="mt-1 text-xl font-semibold text-marca-900">Panel de administración</h1>

      {error && <p class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700">{error}</p>}

      <label class="mt-6 block text-sm font-medium text-marca-700">Email</label>
      <input
        type="email"
        name="email"
        required
        autocomplete="username"
        class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2"
      />

      <label class="mt-4 block text-sm font-medium text-marca-700">Contraseña</label>
      <input
        type="password"
        name="password"
        required
        autocomplete="current-password"
        class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2"
      />

      <button type="submit" class="mt-6 w-full rounded-full bg-marca-600 py-2.5 font-medium text-white hover:bg-marca-700">
        Ingresar
      </button>
    </form>
  </body>
</html>
