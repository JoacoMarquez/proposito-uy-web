---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getProductos, getRecetas } from "../../db/queries";

const [prods, recs] = await Promise.all([getProductos(), getRecetas()]);
const cards = [
  { titulo: "Productos", cantidad: prods.length, href: "/admin/productos", detalle: "Editar productos, precios y disponibilidad" },
  { titulo: "Recetas", cantidad: recs.length, href: "/admin/recetas", detalle: "Editar las recetas del recetario" },
];
---

<AdminLayout titulo="Inicio">
  <div class="grid gap-5 sm:grid-cols-2">
    {cards.map((c) => (
      <a href={c.href} class="rounded-2xl border border-marca-100 bg-white p-6 hover:shadow-md">
        <p class="text-3xl font-bold text-marca-700">{c.cantidad}</p>
        <h2 class="mt-1 font-semibold text-marca-900">{c.titulo}</h2>
        <p class="mt-1 text-sm text-marca-900/60">{c.detalle}</p>
      </a>
    ))}
  </div>
</AdminLayout>
