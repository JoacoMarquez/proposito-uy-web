---
export const prerender = false;
import "../../styles/global.css";
import { crearReset, htmlMailReset } from "../../lib/password-reset";
import { enviarMailBrevo } from "../../lib/brevo";

let enviado = false;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const email = String(form.get("email") ?? "").trim().toLowerCase();
  if (email) {
    const token = await crearReset("admin", email);
    if (token) {
      const link = `${Astro.url.origin}/admin/restablecer?token=${token}`;
      await enviarMailBrevo({
        to: email,
        subject: "Restablecer contraseña · Panel Propósito UY",
        html: htmlMailReset(link),
      }).catch(() => {});
    }
  }
  enviado = true;
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Recuperar contraseña · Admin Propósito UY</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-crema font-sans">
    <div class="w-full max-w-sm rounded-2xl border border-marca-100 bg-white p-8 shadow-sm">
      <h1 class="text-xl font-semibold text-marca-900">Recuperar contraseña</h1>
      {enviado ? (
        <div class="mt-4 rounded-lg bg-marca-50 p-3 text-sm text-marca-900/80">
          <p>Si hay una cuenta con ese email, te enviamos un enlace para crear una nueva contraseña.</p>
          <a href="/admin/login" class="mt-3 inline-block font-medium text-marca-700 hover:underline">← Volver a ingresar</a>
        </div>
      ) : (
        <>
          <p class="mt-1 text-sm text-marca-900/70">Ingresá tu email y te mandamos un enlace.</p>
          <form method="POST" class="mt-5 space-y-4">
            <div>
              <label class="block text-sm font-medium text-marca-700">Email</label>
              <input type="email" name="email" required autocomplete="username"
                class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2" />
            </div>
            <button type="submit" class="w-full rounded-full bg-marca-600 py-2.5 font-medium text-white hover:bg-marca-700">Enviar enlace</button>
          </form>
          <a href="/admin/login" class="mt-4 inline-block text-sm font-medium text-marca-700 hover:underline">← Volver a ingresar</a>
        </>
      )}
    </div>
  </body>
</html>
