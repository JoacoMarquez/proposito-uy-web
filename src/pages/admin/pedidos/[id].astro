---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminEditorHeader from "../../../components/AdminEditorHeader.astro";
import {
  getPedidoById,
  getContenido,
  actualizarEstadoPedido,
  actualizarEstadoPago,
  eliminarPedido,
  ESTADOS_PEDIDO,
  ESTADOS_PAGO,
  formatoPrecio,
} from "../../../db/queries";

const id = Number(Astro.params.id);
if (!id || Number.isNaN(id)) return Astro.redirect("/admin/pedidos");

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  // Eliminar pedido (pruebas, duplicados o cargas por error). (PROP-110)
  if (String(form.get("accion") ?? "") === "eliminar") {
    await eliminarPedido(id);
    const numero = String(form.get("numero") ?? "");
    return Astro.redirect(`/admin/pedidos?eliminado=${encodeURIComponent(numero)}`);
  }
  const estado = String(form.get("estado") ?? "");
  if ((ESTADOS_PEDIDO as readonly string[]).includes(estado)) {
    await actualizarEstadoPedido(id, estado);
  }
  const estadoPago = String(form.get("estadoPago") ?? "");
  if ((ESTADOS_PAGO as readonly string[]).includes(estadoPago)) {
    await actualizarEstadoPago(id, estadoPago);
  }
  return Astro.redirect(`/admin/pedidos/${id}?ok=1`);
}

const guardado = Astro.url.searchParams.get("ok") === "1";

const pedido = await getPedidoById(id);
if (!pedido) return Astro.redirect("/admin/pedidos");

const agendaLabel: Record<string, string> = {
  miercoles: "Miércoles",
  viernes: "Viernes",
  coordinacion: "Coordinación personalizada",
};
const fmtFecha = (d: Date) => new Date(d).toLocaleString("es-UY");
const agendaRaw = pedido.fechaAgenda
  ? new Date(pedido.fechaAgenda + "T12:00:00Z").toLocaleDateString("es-UY", { weekday: "long", day: "numeric", month: "long", timeZone: "UTC" })
  : (agendaLabel[pedido.agenda] ?? pedido.agenda);
const agendaTexto = agendaRaw.charAt(0).toUpperCase() + agendaRaw.slice(1);
const waCliente = `https://wa.me/${pedido.celular.replace(/\D/g, "").replace(/^0/, "598")}`;

// Mensaje predefinido de WhatsApp con los datos del pedido (PROP-95).
const tienda = await getContenido("tienda");
const modalidadTxt = pedido.modalidad === "entrega" ? "la entrega" : "el retiro";
const horario =
  pedido.agenda === "coordinacion"
    ? "a coordinar por este medio"
    : pedido.modalidad === "retiro"
      ? String(tienda.horarioRetiro)
      : String(tienda.horarioEntrega);
const mensajeWa =
  pedido.agenda === "coordinacion"
    ? `Hola, ${pedido.nombre}. Te escribimos por tu pedido ${pedido.numero} para coordinar ${modalidadTxt} por este medio.`
    : `Hola, ${pedido.nombre}. Te escribimos por tu pedido ${pedido.numero}. Te confirmamos ${modalidadTxt} para ${agendaTexto} en la franja ${horario}.`;
const waMensaje = `${waCliente}?text=${encodeURIComponent(mensajeWa)}`;
---

<AdminLayout titulo={`Pedido ${pedido.numero}`} ocultarTitulo>
  <AdminEditorHeader
    slot="antetitulo"
    titulo={`Pedido ${pedido.numero}`}
    volverHref="/admin/pedidos"
    volverLabel="Volver a pedidos"
    formId="form-estado"
    guardado={guardado}
  />

  <div class="grid gap-6 md:grid-cols-[1fr_300px]">
    <!-- Detalle -->
    <div class="space-y-6">
      <div class="rounded-2xl border border-marca-100 bg-white p-5">
        <h2 class="font-semibold text-marca-700">Productos</h2>
        <div class="mt-3 space-y-2 text-sm">
          {pedido.items.map((i) => (
            <div class="flex justify-between">
              <span>{i.cantidad}× {i.nombre} <span class="text-marca-500">({i.presentacion})</span></span>
              <span>{formatoPrecio(i.precioUnitario * i.cantidad)}</span>
            </div>
          ))}
          <div class="flex justify-between border-t border-marca-100 pt-2"><span>Subtotal</span><span>{formatoPrecio(pedido.subtotal)}</span></div>
          <div class="flex justify-between"><span>Envío</span><span>{pedido.costoEnvio === 0 ? "Gratis" : formatoPrecio(pedido.costoEnvio)}</span></div>
          <div class="flex justify-between text-lg font-bold text-marca-900"><span>Total</span><span>{formatoPrecio(pedido.total)}</span></div>
        </div>
      </div>

      <div class="rounded-2xl border border-marca-100 bg-white p-5">
        <h2 class="font-semibold text-marca-700">Cliente y logística</h2>
        <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
          <div><dt class="text-marca-500">Nombre</dt><dd class="font-medium">{pedido.nombre}</dd></div>
          <div><dt class="text-marca-500">Celular</dt><dd class="font-medium"><a href={waCliente} target="_blank" rel="noopener" class="text-marca-700 hover:underline">{pedido.celular}</a></dd></div>
          <div class="col-span-2"><dt class="text-marca-500">Email</dt><dd class="font-medium">{pedido.email}</dd></div>
          <div><dt class="text-marca-500">Modalidad</dt><dd class="font-medium">{pedido.modalidad === "entrega" ? "Entrega" : "Retiro"}</dd></div>
          <div><dt class="text-marca-500">Agenda</dt><dd class="font-medium">{agendaTexto}</dd></div>
          {pedido.direccion && <div class="col-span-2"><dt class="text-marca-500">Dirección</dt><dd class="font-medium">{pedido.direccion}</dd></div>}
          <div><dt class="text-marca-500">Pago</dt><dd class="font-medium capitalize">{pedido.metodoPago}</dd></div>
          <div><dt class="text-marca-500">Fecha</dt><dd class="font-medium">{fmtFecha(pedido.creadoEn)}</dd></div>
          {pedido.notas && <div class="col-span-2"><dt class="text-marca-500">Notas</dt><dd class="font-medium">{pedido.notas}</dd></div>}
        </dl>
      </div>
    </div>

    <!-- Estado -->
    <aside class="h-fit rounded-2xl border border-marca-100 bg-white p-5">
      <h2 class="font-semibold text-marca-700">Estado del pedido</h2>
      <form id="form-estado" method="POST" class="mt-3 space-y-3">
        <div>
          <label class="text-xs font-medium text-marca-500">Estado del pedido</label>
          <select name="estado" class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2 text-sm capitalize">
            {ESTADOS_PEDIDO.map((e) => (
              <option value={e} selected={pedido.estado === e}>{e}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="text-xs font-medium text-marca-500">Estado de pago</label>
          <select name="estadoPago" class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2 text-sm capitalize">
            {ESTADOS_PAGO.map((e) => (
              <option value={e} selected={pedido.estadoPago === e}>{e}</option>
            ))}
          </select>
        </div>
      </form>

      <a
        href={waMensaje}
        target="_blank"
        rel="noopener"
        class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-green-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-green-700"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.042zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        Escribir por WhatsApp
      </a>
      <p class="mt-1.5 text-center text-xs text-marca-500">Abre WhatsApp con un mensaje ya armado.</p>

      <form
        method="POST"
        class="mt-6 border-t border-marca-100 pt-4"
        onsubmit={`return confirm('¿Eliminar el pedido ${pedido.numero}? Esta acción no se puede deshacer.')`}
      >
        <input type="hidden" name="accion" value="eliminar" />
        <input type="hidden" name="numero" value={pedido.numero} />
        <button
          type="submit"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-red-200 px-4 py-2.5 text-sm font-medium text-red-700 transition hover:bg-red-50"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2m2 0v14a1 1 0 01-1 1H6a1 1 0 01-1-1V6m3 5v6m4-6v6" />
          </svg>
          Eliminar pedido
        </button>
        <p class="mt-1.5 text-center text-xs text-marca-500">Borra el pedido del panel. No se puede deshacer.</p>
      </form>
    </aside>
  </div>
</AdminLayout>
