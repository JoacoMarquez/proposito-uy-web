---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminEditorHeader from "../../../components/AdminEditorHeader.astro";
import ImageField from "../../../components/ImageField.astro";
import ChipInput from "../../../components/ChipInput.astro";
import {
  getRecetaById,
  getProductos,
  upsertReceta,
  deleteReceta,
  type RecetaInput,
} from "../../../db/queries";
import { procesarImagenSubida } from "../../../lib/upload";

const { id: idParam } = Astro.params;
const esNuevo = idParam === "nuevo";
const id = esNuevo ? null : Number(idParam);
if (!esNuevo && (!id || Number.isNaN(id))) return Astro.redirect("/admin/recetas");

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();

  if (form.get("_action") === "delete" && id) {
    await deleteReceta(id);
    return Astro.redirect("/admin/recetas");
  }

  const s = (k: string) => String(form.get(k) ?? "").trim();
  const sn = (k: string) => (s(k) === "" ? null : s(k));
  const lineas = (k: string) =>
    s(k)
      .split("\n")
      .map((x) => x.trim())
      .filter(Boolean);

  const rendKeys = ["cantidad", "porcion", "porciones", "tiempo"] as const;
  const rendimiento: Record<string, any> = {};
  for (const k of rendKeys) if (s(`rend_${k}`)) rendimiento[k] = s(`rend_${k}`);
  // Títulos editables de las 6 fichas → rendimiento.titulos
  const slotsFicha = ["cantidad", "porcion", "porciones", "tiempo", "envase", "conservacion"] as const;
  const titulos: Record<string, string> = {};
  for (const slot of slotsFicha) if (s(`titulo_${slot}`)) titulos[slot] = s(`titulo_${slot}`);
  if (Object.keys(titulos).length) rendimiento.titulos = titulos;

  // Imagen: archivo nuevo → se guarda y se usa su URL; si no, se conserva la actual.
  const subida = await procesarImagenSubida(form);
  const subida2 = await procesarImagenSubida(form, "imagen2File");

  const data: RecetaInput = {
    slug: s("slug"),
    titulo: s("titulo"),
    descripcion: s("descripcion"),
    productosAliados: form.getAll("productosAliados").map((x) => String(x)),
    almacenamientoEnvase: sn("almacenamientoEnvase"),
    almacenamientoVidaUtil: sn("almacenamientoVidaUtil"),
    rendimiento: Object.keys(rendimiento).length ? rendimiento : null,
    ingredientes: lineas("ingredientes"),
    procedimiento: lineas("procedimiento"),
    materiales: lineas("materiales"),
    notas: lineas("notas"),
    imagen: subida.url ?? sn("imagen"),
    imagen2: subida2.url ?? sn("imagen2"),
    orden: Number.parseInt(s("orden"), 10) || 0,
  };

  if (subida.error || subida2.error) {
    error = subida.error ?? subida2.error ?? "";
  } else if (!data.slug || !data.titulo) {
    error = "Completá al menos slug y título.";
  } else {
    const nuevoId = await upsertReceta(id, data);
    return Astro.redirect(`/admin/recetas/${nuevoId}?ok=1`);
  }
}

const guardado = Astro.url.searchParams.get("ok") === "1";

const receta = id ? await getRecetaById(id) : undefined;
if (!esNuevo && !receta) return Astro.redirect("/admin/recetas");

const todos = await getProductos();
const r = receta;
const rend = (r?.rendimiento ?? {}) as Record<string, any>;
const campoBase = "mt-1 w-full rounded-xl border border-marca-300 px-3 py-2 text-sm";

// Las 6 fichas (mismo formato que la web). El título de cada una es editable
// (se guarda en rendimiento.titulos); el valor mantiene su ubicación actual.
const titulosGuardados = (rend.titulos ?? {}) as Record<string, string>;
const FICHAS = [
  { slot: "cantidad", tituloDef: "Cantidad", valueName: "rend_cantidad", valor: rend.cantidad ?? "" },
  { slot: "porcion", tituloDef: "Porción", valueName: "rend_porcion", valor: rend.porcion ?? "" },
  { slot: "porciones", tituloDef: "Porciones", valueName: "rend_porciones", valor: rend.porciones ?? "" },
  { slot: "tiempo", tituloDef: "Tiempo", valueName: "rend_tiempo", valor: rend.tiempo ?? "" },
  { slot: "envase", tituloDef: "Envase", valueName: "almacenamientoEnvase", valor: r?.almacenamientoEnvase ?? "" },
  { slot: "conservacion", tituloDef: "Conservación", valueName: "almacenamientoVidaUtil", valor: r?.almacenamientoVidaUtil ?? "" },
];
---

<AdminLayout titulo={esNuevo ? "Nueva receta" : `Editar: ${r?.titulo}`} ocultarTitulo>
  <AdminEditorHeader
    slot="antetitulo"
    titulo={esNuevo ? "Nueva receta" : r?.titulo ?? "Editar receta"}
    volverHref="/admin/recetas"
    volverLabel="Volver a recetas"
    formId="editor-receta"
    guardado={guardado}
  >
    {!esNuevo && (
      <form slot="acciones" method="POST">
        <input type="hidden" name="_action" value="delete" />
        <button
          type="submit"
          onclick="return confirm('¿Eliminar esta receta?')"
          class="rounded-full border border-red-300 px-4 py-2 text-sm font-medium text-red-600 transition hover:bg-red-50"
        >
          Eliminar
        </button>
      </form>
    )}
  </AdminEditorHeader>

  {error && <p class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700">{error}</p>}

  <form id="editor-receta" method="POST" enctype="multipart/form-data" class="max-w-3xl space-y-5">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="text-sm font-medium text-marca-700">Título</label>
        <input name="titulo" value={r?.titulo ?? ""} required class={campoBase} />
      </div>
      <div>
        <label class="text-sm font-medium text-marca-700">Slug (URL)</label>
        <input name="slug" value={r?.slug ?? ""} required class={campoBase} />
      </div>
    </div>

    <div>
      <label class="text-sm font-medium text-marca-700">Descripción</label>
      <textarea name="descripcion" rows="3" class={campoBase}>{r?.descripcion ?? ""}</textarea>
    </div>

    <div class="max-w-[10rem]">
      <label class="text-sm font-medium text-marca-700">Orden</label>
      <p class="text-xs text-marca-500">Menor primero. También se puede arrastrar en la lista.</p>
      <input type="number" name="orden" value={r?.orden ?? 0} class={campoBase} />
    </div>

    <!-- Imagen -->
    <ImageField imagen={r?.imagen} alt={r?.titulo ?? "imagen"} label="Imagen principal" />
    <ImageField imagen={r?.imagen2} alt={r?.titulo ?? "imagen"} name="imagen2" fieldId="imagen2File" label="Imagen secundaria" />

    <div>
      <label class="text-sm font-medium text-marca-700">Productos aliados</label>
      <select name="productosAliados" multiple size="5" class={campoBase}>
        {todos.map((x) => (
          <option value={x.slug} selected={r?.productosAliados.includes(x.slug)}>{x.nombre} | {x.variante}</option>
        ))}
      </select>
      <p class="text-xs text-marca-500">Ctrl/Cmd + click para elegir varios.</p>
    </div>

    <div>
      <label class="text-sm font-medium text-marca-700">Tarjetas de la ficha</label>
      <p class="text-xs text-marca-500">Se ven igual que en la web. Editá el título y el valor de cada una.</p>
      <div class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {FICHAS.map((f) => (
          <div class="rounded-xl bg-marca-50 p-3">
            <input
              name={`titulo_${f.slot}`}
              value={titulosGuardados[f.slot] ?? f.tituloDef}
              placeholder="Título"
              class="w-full border-0 bg-transparent p-0 text-xs font-semibold uppercase tracking-wide text-marca-500 focus:outline-none focus:ring-0"
            />
            <input
              name={f.valueName}
              value={f.valor}
              placeholder="Valor"
              class="mt-1 w-full border-0 bg-transparent p-0 text-sm font-medium text-marca-900 placeholder:font-normal placeholder:text-marca-400 focus:outline-none focus:ring-0"
            />
          </div>
        ))}
      </div>
    </div>

    <div>
      <label class="text-sm font-medium text-marca-700">Utensilios</label>
      <p class="text-xs text-marca-500">Ej: Horno, Mixer. Escribí y Enter para agregar cada uno.</p>
      <ChipInput name="materiales" valor={r?.materiales ?? []} placeholder="Agregá un utensilio y Enter" />
    </div>

    <div>
      <label class="text-sm font-medium text-marca-700">Ingredientes (uno por línea)</label>
      <p class="text-xs text-marca-500">Escribí <code>1/3</code> y se convierte en ⅓ automáticamente.</p>
      <textarea id="ingredientes" name="ingredientes" rows="6" class={campoBase}>{(r?.ingredientes ?? []).join("\n")}</textarea>
    </div>

    <div>
      <label class="text-sm font-medium text-marca-700">Procedimiento (un paso por línea)</label>
      <textarea id="procedimiento" name="procedimiento" rows="8" class={campoBase}>{(r?.procedimiento ?? []).join("\n")}</textarea>
    </div>

    <div>
      <label class="text-sm font-medium text-marca-700">Notas</label>
      <p class="text-xs text-marca-500">Aparecen al final de la receta. Escribí y Enter para agregar cada una.</p>
      <ChipInput name="notas" valor={r?.notas ?? []} placeholder="Agregá una nota y Enter" />
    </div>

  </form>
</AdminLayout>
