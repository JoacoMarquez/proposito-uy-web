---
export const prerender = false;
import "../../styles/global.css";
import { validarReset, consumirReset } from "../../lib/password-reset";

const token = Astro.url.searchParams.get("token") ?? "";
let error = "";
let listo = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const pass = String(form.get("password") ?? "");
  const pass2 = String(form.get("password2") ?? "");
  if (pass !== pass2) {
    error = "Las contraseñas no coinciden.";
  } else {
    const res = await consumirReset(token, pass);
    if (res.error) error = res.error;
    else listo = true;
  }
}

const valido = listo || (await validarReset(token)) != null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Nueva contraseña · Admin Propósito UY</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-crema font-sans">
    <div class="w-full max-w-sm rounded-2xl border border-marca-100 bg-white p-8 shadow-sm">
      <h1 class="text-xl font-semibold text-marca-900">Nueva contraseña</h1>

      {listo ? (
        <div class="mt-4 rounded-lg bg-marca-50 p-3 text-sm text-marca-900/80">
          <p>¡Listo! Tu contraseña se actualizó.</p>
          <a href="/admin/login" class="mt-3 inline-block font-medium text-marca-700 hover:underline">Ir a ingresar →</a>
        </div>
      ) : !valido ? (
        <div class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700">
          <p>El enlace no es válido o ya venció.</p>
          <a href="/admin/recuperar" class="mt-3 inline-block font-medium text-marca-700 hover:underline">Pedir un nuevo enlace</a>
        </div>
      ) : (
        <>
          {error && <p class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700">{error}</p>}
          <form method="POST" class="mt-5 space-y-4">
            <div>
              <label class="block text-sm font-medium text-marca-700">Nueva contraseña</label>
              <input type="password" name="password" required minlength="6" autocomplete="new-password"
                class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2" />
            </div>
            <div>
              <label class="block text-sm font-medium text-marca-700">Repetir contraseña</label>
              <input type="password" name="password2" required minlength="6" autocomplete="new-password"
                class="mt-1 w-full rounded-xl border border-marca-300 px-3 py-2" />
            </div>
            <button type="submit" class="w-full rounded-full bg-marca-600 py-2.5 font-medium text-white hover:bg-marca-700">Guardar contraseña</button>
          </form>
        </>
      )}
    </div>
  </body>
</html>
