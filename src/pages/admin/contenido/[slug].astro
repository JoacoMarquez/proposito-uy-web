---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ImageField from "../../../components/ImageField.astro";
import TablaEditor from "../../../components/TablaEditor.astro";
import { esquemaDePagina, camposSimples, RUTAS_SITIO } from "../../../db/paginas-esquema";
import { getContenido, upsertPagina } from "../../../db/queries";
import { procesarImagenSubida } from "../../../lib/upload";

const { slug } = Astro.params;
const esquema = slug ? esquemaDePagina(slug) : undefined;
if (!esquema || !slug) return Astro.redirect("/admin/contenido");

let guardado = false;
let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const bloques: Record<string, unknown> = {};
  for (const campo of camposSimples(esquema)) {
    if (campo.tipo === "imagen") {
      // Si se subió un archivo nuevo, usa su URL; si no, conserva la actual
      // (el hidden con name=campo.key trae la URL vigente).
      const sub = await procesarImagenSubida(form, `file_${campo.key}`);
      if (sub.error) error = sub.error;
      bloques[campo.key] = sub.url ?? String(form.get(campo.key) ?? "");
    } else if (campo.tipo === "tabla") {
      try {
        const parsed = JSON.parse(String(form.get(campo.key) ?? "{}"));
        bloques[campo.key] = { columnas: parsed.columnas ?? [], filas: parsed.filas ?? [] };
      } catch {
        bloques[campo.key] = { columnas: [], filas: [] };
      }
    } else {
      bloques[campo.key] = String(form.get(campo.key) ?? "").trim();
    }
  }
  if (!error) {
    await upsertPagina(slug, bloques);
    guardado = true;
  }
}

const c = await getContenido(slug);
const campoBase = "mt-1 w-full rounded-xl border border-marca-300 px-3 py-2 text-sm";
---

<AdminLayout titulo={`Contenido · ${esquema.titulo}`} ocultarTitulo>
  <div
    slot="antetitulo"
    class="sticky top-0 z-20 -mx-8 -mt-8 mb-6 flex items-center gap-3 border-b border-marca-100 bg-crema/95 px-8 py-3 backdrop-blur"
  >
    <a
      href="/admin/contenido"
      class="inline-flex shrink-0 items-center gap-1 rounded-full bg-marca-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-marca-700"
    >
      ← Volver a Contenido
    </a>
    <h1 class="min-w-0 flex-1 truncate text-center text-base font-semibold text-marca-700 sm:text-lg">
      <span class="font-normal text-marca-500">Contenido · </span>{esquema.titulo}
    </h1>
    <button
      id="btn-guardar"
      type="submit"
      form="editor-contenido"
      class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-marca-500 px-5 py-2 text-sm font-medium text-white transition hover:bg-marca-600"
    >
      <svg
        data-tick
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class:list={["h-4 w-4", !guardado && "hidden"]}
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
      </svg>
      <span data-texto>{guardado ? "Guardado" : "Guardar"}</span>
    </button>
  </div>

  {error && (
    <p class="mt-4 max-w-2xl rounded-lg bg-red-50 p-3 text-sm text-red-700">{error}</p>
  )}

  <form id="editor-contenido" method="POST" enctype="multipart/form-data" class="mt-4 max-w-2xl space-y-8">
    {esquema.secciones.map((seccion) => (
      <fieldset class="rounded-2xl border border-marca-100 bg-white p-5">
        <legend class="px-2 font-semibold text-marca-700">{seccion.titulo}</legend>
        <div class="space-y-4">
          {seccion.campos.map((campo) => (
            campo.tipo === "imagen" ? (
              <div>
                <ImageField name={campo.key} fieldId={`file_${campo.key}`} imagen={c[campo.key]} label={campo.label} ayuda={campo.ayuda} />
              </div>
            ) : campo.tipo === "checkbox" ? (
              <div>
                <label class="flex items-center gap-2 text-sm font-medium text-marca-700">
                  <input type="checkbox" name={campo.key} value="si" checked={c[campo.key] === "si"} class="h-4 w-4 rounded border-marca-300 text-marca-600" />
                  {campo.label}
                </label>
                {campo.ayuda && <p class="mt-1 text-xs text-marca-500">{campo.ayuda}</p>}
              </div>
            ) : campo.tipo === "tabla" ? (
              <div>
                <label class="text-sm font-medium text-marca-700">{campo.label}</label>
                {campo.ayuda && <p class="text-xs text-marca-500">{campo.ayuda}</p>}
                <div class="mt-1">
                  <TablaEditor name={campo.key} valor={c[campo.key]} />
                </div>
              </div>
            ) : (
              <div>
                <label class="text-sm font-medium text-marca-700">{campo.label}</label>
                {campo.ayuda && <p class="text-xs text-marca-500">{campo.ayuda}</p>}
                {campo.tipo === "richtext" ? (
                  <textarea name={campo.key} rows="3" class={campoBase}>{c[campo.key] ?? ""}</textarea>
                ) : campo.tipo === "fecha" ? (
                  <input type="date" name={campo.key} value={c[campo.key] ?? ""} class={campoBase} />
                ) : campo.tipo === "ruta" ? (
                  <select name={campo.key} class={campoBase}>
                    {c[campo.key] && !RUTAS_SITIO.some((r) => r.value === c[campo.key]) && (
                      <option value={c[campo.key]} selected>{c[campo.key]}</option>
                    )}
                    {RUTAS_SITIO.map((r) => (
                      <option value={r.value} selected={c[campo.key] === r.value}>{r.label} ({r.value})</option>
                    ))}
                  </select>
                ) : (
                  <input name={campo.key} value={c[campo.key] ?? ""} class={campoBase} />
                )}
              </div>
            )
          ))}
        </div>
      </fieldset>
    ))}
  </form>

  <!-- Aviso de cambios sin guardar -->
  <div id="modal-sin-guardar" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl">
      <h2 class="text-lg font-semibold text-marca-900">Cambios sin guardar</h2>
      <p class="mt-2 text-sm text-marca-900/70">
        Hiciste cambios que todavía no guardaste. Si salís ahora, se van a perder.
      </p>
      <div class="mt-5 flex flex-wrap justify-end gap-3">
        <button type="button" data-salir class="rounded-full border border-marca-300 px-5 py-2 text-sm font-medium text-marca-700 transition hover:bg-marca-50">
          Salir sin guardar
        </button>
        <button type="button" data-seguir class="rounded-full bg-marca-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-marca-700">
          Seguir editando
        </button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  function setupGuardaContenido() {
    const form = document.getElementById("editor-contenido") as HTMLFormElement | null;
    if (!form) return;
    const modal = document.getElementById("modal-sin-guardar");
    let dirty = false;
    let pendingHref: string | null = null;

    const btnTexto = document.querySelector("#btn-guardar [data-texto]");
    const btnTick = document.querySelector("#btn-guardar [data-tick]");

    const marcarSucio = () => {
      dirty = true;
      if (btnTexto) btnTexto.textContent = "Guardar";
      btnTick?.classList.add("hidden");
    };
    form.addEventListener("input", marcarSucio);
    form.addEventListener("change", marcarSucio);
    form.addEventListener("submit", () => {
      dirty = false;
      if (btnTexto) btnTexto.textContent = "Guardando…";
      btnTick?.classList.add("hidden");
    });

    const abrir = () => { modal?.classList.remove("hidden"); modal?.classList.add("flex"); };
    const cerrar = () => { modal?.classList.add("hidden"); modal?.classList.remove("flex"); };

    // Interceptar clicks en links cuando hay cambios sin guardar → modal.
    document.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest("a[href]") as HTMLAnchorElement | null;
      if (!a || !dirty) return;
      const href = a.getAttribute("href");
      if (!href || href.startsWith("#") || a.target === "_blank") return;
      e.preventDefault();
      pendingHref = a.href;
      abrir();
    });

    modal?.querySelector("[data-seguir]")?.addEventListener("click", () => { pendingHref = null; cerrar(); });
    modal?.querySelector("[data-salir]")?.addEventListener("click", () => {
      dirty = false;
      cerrar();
      if (pendingHref) window.location.href = pendingHref;
    });
    modal?.addEventListener("click", (e) => { if (e.target === modal) { pendingHref = null; cerrar(); } });

    // Refrescar / cerrar pestaña: aviso nativo del navegador.
    window.addEventListener("beforeunload", (e) => {
      if (!dirty) return;
      e.preventDefault();
      e.returnValue = "";
    });
  }

  setupGuardaContenido();
</script>
