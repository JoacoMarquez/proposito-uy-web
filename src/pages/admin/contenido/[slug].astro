---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { esquemaDePagina, camposSimples } from "../../../db/paginas-esquema";
import { getContenido, upsertPagina } from "../../../db/queries";

const { slug } = Astro.params;
const esquema = slug ? esquemaDePagina(slug) : undefined;
if (!esquema || !slug) return Astro.redirect("/admin/contenido");

let guardado = false;
let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const bloques: Record<string, unknown> = {};
  for (const campo of camposSimples(esquema)) {
    bloques[campo.key] = String(form.get(campo.key) ?? "").trim();
  }
  await upsertPagina(slug, bloques);
  guardado = true;
}

const c = await getContenido(slug);
const campoBase = "mt-1 w-full rounded-xl border border-marca-300 px-3 py-2 text-sm";
---

<AdminLayout titulo={`Contenido · ${esquema.titulo}`}>
  <a href="/admin/contenido" class="text-sm text-marca-700 hover:underline">← Volver a Contenido</a>

  {guardado && (
    <p class="mt-4 max-w-2xl rounded-lg bg-green-50 p-3 text-sm text-green-700">Contenido guardado.</p>
  )}
  {error && (
    <p class="mt-4 max-w-2xl rounded-lg bg-red-50 p-3 text-sm text-red-700">{error}</p>
  )}

  <form method="POST" class="mt-4 max-w-2xl space-y-8">
    {esquema.secciones.map((seccion) => (
      <fieldset class="rounded-2xl border border-marca-100 bg-white p-5">
        <legend class="px-2 font-semibold text-marca-700">{seccion.titulo}</legend>
        <div class="space-y-4">
          {seccion.campos.map((campo) => (
            <div>
              <label class="text-sm font-medium text-marca-700">{campo.label}</label>
              {campo.ayuda && <p class="text-xs text-marca-500">{campo.ayuda}</p>}
              {campo.tipo === "richtext" ? (
                <textarea name={campo.key} rows="3" class={campoBase}>{c[campo.key] ?? ""}</textarea>
              ) : campo.tipo === "text" || campo.tipo === "link" ? (
                <input name={campo.key} value={c[campo.key] ?? ""} class={campoBase} />
              ) : (
                <p class="mt-1 rounded-lg bg-marca-50 p-2 text-xs text-marca-500">
                  Este campo ({campo.tipo}) se podrá editar en una próxima etapa.
                </p>
              )}
            </div>
          ))}
        </div>
      </fieldset>
    ))}

    <div class="flex items-center gap-3">
      <button type="submit" class="rounded-full bg-marca-600 px-6 py-2.5 font-medium text-white hover:bg-marca-700">
        Guardar
      </button>
      <a href="/admin/contenido" class="text-sm text-marca-700 hover:underline">Cancelar</a>
    </div>
  </form>
</AdminLayout>
