---
import Layout from "../layouts/Layout.astro";

// Compromisos (carta de compromisos con iconos). TODO: textos reales.
// icono = path SVG (heroicons, trazo). Cambiá el texto libremente.
const compromisos = [
  { titulo: "Ingredientes reales", detalle: "Sin aditivos innecesarios.", icono: "M12 2.25a.75.75 0 0 1 .75.75v.756a49.1 49.1 0 0 1 9.152 1 .75.75 0 0 1-.152 1.485h-1.918l2.474 10.124a.75.75 0 0 1-.375.84A6.7 6.7 0 0 1 18.75 18a6.7 6.7 0 0 1-3.181-.795.75.75 0 0 1-.375-.84l2.474-10.124H12.75v13.28c1.293.076 2.534.343 3.697.776a.75.75 0 0 1-.262 1.453h-8.37a.75.75 0 0 1-.262-1.453c1.162-.433 2.404-.7 3.697-.775V6.24H6.332l2.474 10.124a.75.75 0 0 1-.375.84A6.7 6.7 0 0 1 5.25 18a6.7 6.7 0 0 1-3.181-.795.75.75 0 0 1-.375-.84L4.168 6.241H2.25a.75.75 0 0 1-.152-1.485 49.1 49.1 0 0 1 9.152-1V3a.75.75 0 0 1 .75-.75Z" },
  { titulo: "Producción consciente", detalle: "Cuidamos cada etapa.", icono: "M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" },
  { titulo: "Impacto ambiental", detalle: "Envases retornables.", icono: "M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.4 48.4 0 0 0 12 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52 2.62 10.726c.122.499-.106 1.028-.589 1.202a6 6 0 0 1-3.7.21 6 6 0 0 1-3.7-.21c-.483-.174-.711-.703-.59-1.202L18.75 4.97ZM4.5 5.49l2.62 10.726c.122.499-.106 1.028-.589 1.202a6 6 0 0 1-3.7.21 6 6 0 0 1-3.7-.21" },
  { titulo: "Comunidad local", detalle: "Hecho en Uruguay.", icono: "M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" },
];
---

<Layout titulo="Nosotros" descripcion="Quiénes están detrás de Propósito UY y cómo trabajamos.">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-marca-700">Nosotros</h1>

    <!-- Declaración -->
    <p class="mt-6 text-xl leading-relaxed text-marca-900/80">
      Texto pendiente: declaración de la marca. Quiénes somos y por qué hacemos lo que hacemos.
    </p>
  </section>

  <!-- Carta de compromisos -->
  <section class="bg-marca-50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-2xl font-bold text-marca-700">Nuestros compromisos</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {compromisos.map((c) => (
          <div class="rounded-2xl border border-marca-100 bg-white p-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-marca-100">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 text-marca-600">
                <path stroke-linecap="round" stroke-linejoin="round" d={c.icono} />
              </svg>
            </div>
            <h3 class="mt-3 font-semibold text-marca-900">{c.titulo}</h3>
            <p class="mt-1 text-sm text-marca-900/70">{c.detalle}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compromisos en acción (imágenes reales) -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-marca-700">Compromisos en acción</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {[1, 2, 3].map(() => (
        <div class="flex aspect-square items-center justify-center rounded-2xl bg-marca-50 text-sm text-marca-300">
          Foto pendiente
        </div>
      ))}
    </div>
  </section>
</Layout>
