---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import TituloSeccion from "../components/TituloSeccion.astro";
import { getContenido } from "../db/queries";

const c = await getContenido("nosotros");
// Los íconos (paths SVG) se mantienen fijos; lo editable es título/detalle/imagen.
const ICONOS = [
  "M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z",
  "M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  "M9 12.75 11.25 15 15 9.75m-3-7.036A11.96 11.96 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z",
  "M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
  "M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12a8.959 8.959 0 0 1-.16 1.682M4.157 7.582A8.959 8.959 0 0 0 3 12c0 .576.054 1.14.157 1.682",
];
// Carta de compromisos: 5 valores. Título/detalle/imagen vienen del panel.
const valores = [1, 2, 3, 4, 5].map((n, i) => ({
  titulo: c[`valor${n}Titulo`],
  detalle: c[`valor${n}Detalle`],
  imagen: c[`valor${n}Imagen`],
  icono: ICONOS[i],
}));
// "Contenido real": un párrafo por línea (mismo patrón que los acordeones).
const contenidoRealParrafos = String(c.contenidoRealTexto ?? "")
  .split("\n")
  .map((s) => s.trim())
  .filter(Boolean);
---

<Layout titulo="Nosotros" descripcion="Quiénes están detrás de Propósito UY y cómo trabajamos.">
  <!-- Declaración (sin título previo) -->
  <section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="text-2xl font-medium leading-relaxed text-marca-700 sm:text-3xl">
      {c.declaracionIntro}
    </p>
  </section>

  <!-- Carta de compromisos -->
  <section class="bg-marca-50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <TituloSeccion titulo={c.tituloPromesas} />
      <p class="mt-3 max-w-2xl text-marca-900/70">
        {c.subtituloPromesas}
      </p>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {valores.map((v) => (
          <div class="rounded-2xl border border-marca-100 bg-white p-5">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-marca-100">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 text-marca-600">
                <path stroke-linecap="round" stroke-linejoin="round" d={v.icono} />
              </svg>
            </div>
            <h3 class="mt-3 font-semibold text-marca-900">{v.titulo}</h3>
            <p class="mt-1 text-sm text-marca-900/70">{v.detalle}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Los valores en acción -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <TituloSeccion titulo={c.tituloValoresAccion} />
    <p class="mt-3 max-w-2xl text-marca-900/70">
      {c.subtituloValoresAccion}
    </p>
    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {valores.map((v, i) => (
        <img
          src={v.imagen}
          alt={`Propósito — ${v.titulo}`}
          loading="lazy"
          class:list={[
            "w-full rounded-2xl object-cover",
            // En mobile (2 col) la 5ª imagen ocupa el ancho completo y cierra la
            // grilla sin hueco; en sm+ vuelve a una celda cuadrada normal (PROP-104).
            i === valores.length - 1
              ? "col-span-2 aspect-[2/1] sm:col-span-1 sm:aspect-square"
              : "aspect-square",
          ]}
        />
      ))}
    </div>
  </section>

  <!-- Contenido real -->
  <section class="mx-auto max-w-3xl px-4 pb-20">
    <TituloSeccion titulo={c.contenidoRealTitulo} />
    <div class="mt-4 space-y-4 text-marca-900/80">
      {contenidoRealParrafos.map((p) => <p class="leading-relaxed">{p}</p>)}
    </div>
  </section>
</Layout>
