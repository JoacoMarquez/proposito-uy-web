---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { getContenido } from "../db/queries";

const c = await getContenido("contacto");
const aj = await getContenido("ajustes");
---

<Layout titulo="Contacto" descripcion="Estamos para escucharte. Escribinos por WhatsApp.">
  <section class="mx-auto max-w-2xl px-4 py-20 text-center">
    <h1 class="text-3xl font-bold text-marca-700">{c.titulo}</h1>
    <p class="mt-4 text-lg text-marca-900/80">
      {c.parrafo}
    </p>

    <a
      href={aj.whatsappConversacion}
      target="_blank"
      rel="noopener"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-marca-600 px-8 py-4 text-lg font-medium text-white hover:bg-marca-700"
    >
      {c.textoBotonWhatsapp}
    </a>

    <p class="mt-4 text-sm text-marca-900/60">{c.textoHorario} {aj.horarioAtencion}</p>

    <p class="mt-10 text-sm text-marca-900/60">
      {c.textoRedes}
      <a href={aj.instagram} class="font-medium text-marca-700 hover:underline">Instagram</a>.
    </p>
  </section>
</Layout>
