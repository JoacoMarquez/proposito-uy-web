---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import TituloSeccion from "../../components/TituloSeccion.astro";
import { getReceta, getProducto, nombreCompleto } from "../../db/queries";

const { slug } = Astro.params;
const receta = slug ? await getReceta(slug) : undefined;
if (!receta) return Astro.redirect("/recetario");

const aliados = (
  await Promise.all(receta.productosAliados.map((s) => getProducto(s)))
).filter((p): p is NonNullable<typeof p> => Boolean(p));

const meta = receta.rendimiento ?? {};
const fichas = [
  { label: "Cantidad", valor: meta.cantidad },
  { label: "Porción", valor: meta.porcion },
  { label: "Porciones", valor: meta.porciones },
  { label: "Tiempo", valor: meta.tiempo },
  { label: "Conservación", valor: receta.almacenamientoVidaUtil ?? undefined },
].filter((f) => f.valor);
---

<Layout titulo={receta.titulo} descripcion={receta.descripcion}>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <nav class="text-sm text-marca-600">
      <a href="/recetario" class="hover:underline">Recetario</a> / <span>{receta.titulo}</span>
    </nav>
    <h1 class="mt-2 text-3xl font-bold text-marca-700">{receta.titulo}</h1>
    <p class="mt-1 text-sm text-marca-500">Por Propósito UY</p>

    {receta.imagen ? (
      <img src={receta.imagen} alt={receta.titulo} class="mt-6 aspect-video w-full rounded-2xl object-cover" />
    ) : (
      <div class="mt-6 flex aspect-video items-center justify-center rounded-2xl bg-marca-50 text-sm text-marca-300">
        Foto pendiente
      </div>
    )}

    <p class="mt-6 text-marca-900/80">{receta.descripcion}</p>

    {aliados.length > 0 && (
      <p class="mt-4 text-sm text-marca-700">
        Producto aliado:
        {aliados.map((a, i) => (
          <>
            {i > 0 && " + "}
            <a href={`/producto/${a.slug}`} class="font-medium underline">{nombreCompleto(a)}</a>
          </>
        ))}
      </p>
    )}

    {fichas.length > 0 && (
      <dl class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {fichas.map((f) => (
          <div class="rounded-xl bg-marca-50 p-3">
            <dt class="text-xs uppercase tracking-wide text-marca-500">{f.label}</dt>
            <dd class="mt-1 text-sm font-medium text-marca-900">{f.valor}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="mt-10">
      {receta.materiales.length > 0 && (
        <div class="mb-5">
          <h3 class="inline-flex items-center gap-2 rounded-full bg-acento/15 px-3.5 py-1.5 text-base font-semibold text-marca-700">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 2v7c0 1.1.9 2 2 2h0a2 2 0 0 0 2-2V2" />
              <path d="M5 11v11" />
              <path d="M16 2v20" />
              <path d="M16 8c0-3.3 1.3-6 3-6s3 2.7 3 6-1.3 5-3 5h-3" />
            </svg>
            Utensilios
          </h3>
          <div class="mt-2.5 flex flex-wrap gap-2">
            {receta.materiales.map((m) => (
              <span class="rounded-full bg-marca-100 px-3 py-1 text-sm font-medium text-marca-700">{m}</span>
            ))}
          </div>
        </div>
      )}
      <TituloSeccion titulo="Ingredientes" />
      <ul class="mt-3 list-disc space-y-1 pl-5 text-marca-900/80">
        {receta.ingredientes.map((i) => <li>{i}</li>)}
      </ul>
    </div>

    <div class="mt-10">
      <TituloSeccion titulo="Procedimiento" />
      <ol class="mt-3 list-decimal space-y-3 pl-5 text-marca-900/80">
        {receta.procedimiento.map((p) => <li>{p}</li>)}
      </ol>
    </div>

    {receta.notas.length > 0 && (
      <div class="mt-10">
        <TituloSeccion titulo="Notas" />
        <div class="mt-3 rounded-2xl border border-marca-100 bg-marca-50 p-4 text-sm text-marca-900/80">
          <ul class="list-disc space-y-1.5 pl-5">
            {receta.notas.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      </div>
    )}
  </section>
</Layout>
