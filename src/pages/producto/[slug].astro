---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import {
  getProducto,
  getCategoria,
  getDestacados,
  nombreCompleto,
  precioDesde,
  formatoPrecio,
} from "../../db/queries";
import FavoritoBoton from "../../components/FavoritoBoton.astro";
import { MIX_SLUG, SABORES_MIX } from "../../lib/barrasMix";
import { site, whatsappLink } from "../../data/site";

const { slug } = Astro.params;
const producto = slug ? await getProducto(slug) : undefined;
if (!producto) return Astro.redirect("/tienda");

const nombre = nombreCompleto(producto);
const cat = await getCategoria(producto.categoriaSlug);
const aliado = producto.productoAliadoSlug ? await getProducto(producto.productoAliadoSlug) : undefined;
const destacados = (await getDestacados()).filter((p) => p.slug !== producto.slug).slice(0, 3);

const detalles = [
  { label: "Ingredientes", valor: producto.ingredientes },
  { label: "Tamaño unitario", valor: producto.tamanoUnitario },
  { label: "Contenido", valor: producto.contenido },
  { label: "Packaging", valor: producto.packaging },
  { label: "Conservación", valor: producto.conservacion },
  { label: "Uso", valor: producto.uso },
  { label: "Vencimiento", valor: producto.vencimiento },
].filter((d) => d.valor);

const mensajeBase = `${site.whatsappMensajeBase} ${nombre}`;
const primera = producto.presentaciones[0];
const esMix = producto.slug === MIX_SLUG;
---

<Layout titulo={nombre} descripcion={producto.descripcion} imagen={producto.imagen ?? undefined}>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <nav class="text-sm text-marca-600">
      <a href="/tienda" class="hover:underline">Tienda</a> /
      <a href={`/tienda/${producto.categoriaSlug}`} class="hover:underline">{cat?.nombre}</a> /
      <span>{nombre}</span>
    </nav>

    <div class="mt-6 grid gap-10 md:grid-cols-2">
      <!-- Galería -->
      <div class="flex aspect-square items-center justify-center rounded-2xl bg-marca-50 text-marca-300">
        {producto.imagen ? (
          <img src={producto.imagen} alt={nombre} class="h-full w-full rounded-2xl object-cover" />
        ) : (
          <span class="text-sm">Foto pendiente</span>
        )}
      </div>

      <!-- Info principal -->
      <div>
        <h1 class="text-3xl font-bold text-marca-900">{producto.nombre}</h1>
        <p class="text-lg text-marca-600">{producto.variante}</p>
        <p class="mt-4 text-marca-900/80">{producto.descripcion}</p>

        {producto.textoInformativo && (
          <p class="mt-4 rounded-xl bg-marca-100 p-3 text-sm text-marca-900/80">
            ❄️ {producto.textoInformativo}
          </p>
        )}

        {!producto.disponible && (
          <p class="mt-4 rounded-xl bg-marca-900/5 p-3 text-sm font-medium text-marca-900">
            Producto temporalmente agotado. Consultanos por WhatsApp.
          </p>
        )}

        {esMix ? (
          <div id="mix-config" class="mt-6 space-y-4" data-slug={producto.slug} data-nombre={nombre}>
            <div>
              <label for="mix-tamano" class="text-sm font-medium text-marca-700">Tamaño de la caja</label>
              <select id="mix-tamano" class="mt-1 block w-full rounded-xl border border-marca-300 bg-white px-3 py-2 text-marca-900">
                {producto.presentaciones.map((pr, i) => (
                  <option value={pr.label} data-precio={pr.precio} data-cantidad={pr.label.replace(/\D/g, "")} selected={i === 0}>
                    {pr.label} — base {formatoPrecio(pr.precio)}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <p class="text-sm font-medium text-marca-700">Elegí los sabores</p>
              <div class="mt-2 grid grid-cols-2 gap-3">
                {SABORES_MIX.map((s) => (
                  <div>
                    <label class="text-sm text-marca-900/80">
                      {s.label}{s.key === "caju" && <span class="text-marca-500"> (+$U16 c/u)</span>}
                    </label>
                    <input
                      type="number"
                      min="0"
                      value="0"
                      data-sabor={s.key}
                      class="mix-sabor mt-1 block w-full rounded-xl border border-marca-300 px-3 py-2 text-center"
                    />
                  </div>
                ))}
              </div>
              <p id="mix-estado" class="mt-2 text-sm text-marca-600">Elegí 12 barras en total.</p>
            </div>

            <p id="precio" class="text-2xl font-bold text-marca-900">{formatoPrecio(primera.precio)}</p>

            <div class="flex items-center gap-3">
              <input id="cantidad-mix" type="number" min="1" value="1" class="w-20 rounded-xl border border-marca-300 px-3 py-3 text-center" />
              <button
                id="agregar-mix"
                disabled
                class="flex-1 rounded-full bg-marca-600 px-6 py-3 font-medium text-white transition-colors hover:bg-marca-700 disabled:cursor-not-allowed disabled:opacity-50"
              >
                Agregar al carrito
              </button>
            </div>
          </div>
        ) : (
          <Fragment>
            <div class="mt-6">
              <label for="presentacion" class="text-sm font-medium text-marca-700">Presentación</label>
              <select
                id="presentacion"
                class="mt-1 block w-full rounded-xl border border-marca-300 bg-white px-3 py-2 text-marca-900"
                data-nombre={nombre}
              >
                {producto.presentaciones.map((pr) => (
                  <option value={pr.label} data-precio={pr.precio}>
                    {pr.label} — {formatoPrecio(pr.precio)}
                  </option>
                ))}
              </select>
            </div>

            <p id="precio" class="mt-4 text-2xl font-bold text-marca-900">
              {formatoPrecio(primera.precio)}
            </p>

            {producto.nota && <p class="mt-2 text-sm text-marca-600">{producto.nota}</p>}

            {producto.disponible ? (
              <div class="mt-6 flex items-center gap-3">
                <input
                  id="cantidad"
                  type="number"
                  min="1"
                  value="1"
                  class="w-20 rounded-xl border border-marca-300 px-3 py-3 text-center"
                />
                <button
                  id="agregar"
                  data-slug={producto.slug}
                  data-nombre={nombre}
                  class="flex-1 rounded-full bg-marca-600 px-6 py-3 font-medium text-white transition-colors hover:bg-marca-700"
                >
                  Agregar al carrito
                </button>
              </div>
            ) : (
              <a
                href={whatsappLink(`Hola! Quiero consultar por ${nombre}`)}
                class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-marca-600 px-6 py-3 font-medium text-white hover:bg-marca-700"
              >
                Consultar por WhatsApp
              </a>
            )}
          </Fragment>
        )}

        <a
          id="pedir"
          href={whatsappLink(`${mensajeBase} (${primera.label})`)}
          class="mt-3 block text-center text-sm text-marca-700 hover:underline"
        >
          o pedir directo por WhatsApp
        </a>

        <div class="mt-4">
          <FavoritoBoton
            slug={producto.slug}
            nombre={nombre}
            variante={producto.variante}
            imagen={producto.imagen ?? undefined}
            precioDesde={precioDesde(producto)}
            desde={producto.presentaciones.length > 1}
            variante2="full"
            class="w-full"
          />
        </div>

        {aliado && (
          <p class="mt-6 text-sm text-marca-700">
            Producto aliado:
            <a href={`/producto/${aliado.slug}`} class="font-medium underline">
              {nombreCompleto(aliado)}
            </a>
          </p>
        )}
      </div>
    </div>

    <!-- Detalles -->
    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {detalles.map((d) => (
        <div class="rounded-xl border border-marca-100 bg-white p-4">
          <h2 class="text-sm font-semibold text-marca-700">{d.label}</h2>
          <p class="mt-1 text-sm text-marca-900/80">{d.valor}</p>
        </div>
      ))}
    </div>

    <!-- Los más pedidos -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold text-marca-700">Los más pedidos</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {destacados.map((p) => <ProductCard producto={p} />)}
      </div>
    </div>
  </section>
</Layout>

<script>
  import { agregar, formatoPrecio } from "../../scripts/cart";

  const select = document.getElementById("presentacion") as HTMLSelectElement | null;
  const precioEl = document.getElementById("precio");
  const pedir = document.getElementById("pedir") as HTMLAnchorElement | null;
  const agregarBtn = document.getElementById("agregar") as HTMLButtonElement | null;
  const cantidadEl = document.getElementById("cantidad") as HTMLInputElement | null;
  const numero = "59897174174";
  const base = "¡Hola Propósito! Quiero hacer un pedido:";

  function presentacionActual() {
    const opt = select!.selectedOptions[0];
    return { label: opt.value, precio: Number(opt.dataset.precio) };
  }

  function actualizar() {
    if (!select) return;
    const { label, precio } = presentacionActual();
    const nombre = select.dataset.nombre ?? "";
    if (precioEl) precioEl.textContent = formatoPrecio(precio);
    if (pedir) {
      pedir.href = `https://wa.me/${numero}?text=${encodeURIComponent(`${base} ${nombre} (${label})`)}`;
    }
  }

  select?.addEventListener("change", actualizar);

  agregarBtn?.addEventListener("click", () => {
    if (!select) return;
    const { label, precio } = presentacionActual();
    const cantidad = Math.max(1, Number(cantidadEl?.value || 1));
    agregar({
      slug: agregarBtn.dataset.slug!,
      nombre: agregarBtn.dataset.nombre!,
      presentacion: label,
      precio,
      cantidad,
    });
    const original = agregarBtn.textContent;
    agregarBtn.textContent = "✓ Agregado";
    setTimeout(() => (agregarBtn.textContent = original), 1200);
  });
</script>

<script>
  import { agregar, formatoPrecio } from "../../scripts/cart";
  import {
    SABORES_MIX,
    RECARGO_CAJU,
    etiquetaMix,
    type SaborKey,
    type SaboresMix,
  } from "../../lib/barrasMix";

  const cfg = document.getElementById("mix-config");
  if (cfg) {
    const tamanoSel = document.getElementById("mix-tamano") as HTMLSelectElement;
    const saborInputs = Array.from(cfg.querySelectorAll<HTMLInputElement>(".mix-sabor"));
    const estadoEl = document.getElementById("mix-estado")!;
    const precioEl = document.getElementById("precio")!;
    const cantidadEl = document.getElementById("cantidad-mix") as HTMLInputElement;
    const btn = document.getElementById("agregar-mix") as HTMLButtonElement;

    const leerSabores = (): SaboresMix => {
      const s = {} as SaboresMix;
      for (const inp of saborInputs) s[inp.dataset.sabor as SaborKey] = Math.max(0, Number(inp.value) || 0);
      return s;
    };

    function actualizar() {
      const opt = tamanoSel.selectedOptions[0];
      const base = Number(opt.dataset.precio);
      const cap = Number(opt.dataset.cantidad);
      const sabores = leerSabores();
      const total = SABORES_MIX.reduce((n, x) => n + (sabores[x.key] || 0), 0);
      const precio = base + RECARGO_CAJU * (sabores.caju || 0);

      precioEl.textContent = formatoPrecio(precio);

      const ok = total === cap;
      btn.disabled = !ok;
      if (total === 0) {
        estadoEl.className = "mt-2 text-sm text-marca-600";
        estadoEl.textContent = `Elegí ${cap} barras en total.`;
      } else if (ok) {
        estadoEl.className = "mt-2 text-sm text-marca-700";
        estadoEl.textContent = `¡Listo! ${cap} barras seleccionadas.`;
      } else {
        estadoEl.className = "mt-2 text-sm text-red-600";
        const diff = Math.abs(total - cap);
        const barras = diff === 1 ? "barra" : "barras";
        estadoEl.textContent =
          total < cap ? `Te ${diff === 1 ? "falta" : "faltan"} ${diff} ${barras}.` : `Te pasaste por ${diff} ${barras}.`;
      }
    }

    tamanoSel.addEventListener("change", actualizar);
    saborInputs.forEach((inp) => inp.addEventListener("input", actualizar));
    actualizar();

    btn.addEventListener("click", () => {
      if (btn.disabled) return;
      const opt = tamanoSel.selectedOptions[0];
      const base = Number(opt.dataset.precio);
      const mix = { tamano: tamanoSel.value, sabores: leerSabores() };
      const precio = base + RECARGO_CAJU * (mix.sabores.caju || 0);
      const cantidad = Math.max(1, Number(cantidadEl.value) || 1);
      agregar({
        slug: cfg.dataset.slug!,
        nombre: cfg.dataset.nombre!,
        presentacion: etiquetaMix(mix),
        precio,
        cantidad,
        mix,
      });
      const original = btn.textContent;
      btn.textContent = "✓ Agregado";
      setTimeout(() => (btn.textContent = original), 1200);
    });
  }
</script>
