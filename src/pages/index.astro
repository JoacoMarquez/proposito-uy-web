---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import CategoriaCard from "../components/CategoriaCard.astro";
import TituloSeccion from "../components/TituloSeccion.astro";
import { getDestacados, getCategorias, getContenido } from "../db/queries";

const destacados = await getDestacados();
const categoriasLista = await getCategorias();
const c = await getContenido("inicio");

const atajos = [
  { href: c.atajo1Href, titulo: c.atajo1Titulo, imagen: c.atajo1Imagen },
  { href: c.atajo2Href, titulo: c.atajo2Titulo, imagen: c.atajo2Imagen },
  { href: c.atajo3Href, titulo: c.atajo3Titulo, imagen: c.atajo3Imagen },
];
---

<Layout>
  <!-- Hero principal: placa de marca + frase principal + CTA -->
  <section class="bg-marca-100 text-center">
    <img
      src={c.heroImagen}
      alt={c.heroAlt}
      class="h-56 w-full object-cover sm:h-80 lg:h-96"
    />
    <div class="px-4 pb-10 sm:pb-14">
      <h1 class="mx-auto max-w-3xl pt-6 text-xl font-bold leading-tight text-marca-700 sm:pt-8 sm:text-3xl">
        {c.presentacionFrase}
      </h1>
      <a
        href={c.heroCtaLink}
        class="mt-5 inline-block rounded-full bg-marca-600 px-8 py-3 font-medium text-white hover:bg-marca-700 sm:mt-8"
      >
        {c.heroCtaTexto}
      </a>
    </div>
  </section>

  <!-- Categorías de productos -->
  <section class="bg-marca-50">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:py-16">
      <TituloSeccion titulo={c.tituloCategorias} />
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5">
        {categoriasLista.map((c) => (
          <CategoriaCard slug={c.slug} nombre={c.nombre} descripcion={c.descripcion} imagen={c.imagen} />
        ))}
        {/* Solo mobile: completa la grilla 2x2 con acceso al catálogo completo. */}
        <a
          href="/tienda/catalogo"
          class="relative flex aspect-[4/3] overflow-hidden rounded-2xl bg-marca-600 transition hover:bg-marca-700 sm:hidden"
        >
          {c.catalogoImagen && (
            <img src={c.catalogoImagen} alt="Catálogo" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-3">
            <h3 class="text-base font-semibold text-white">Catálogo</h3>
            <p class="mt-1 text-xs text-white/85">Ver todos los productos</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Atajos -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:py-16">
    <TituloSeccion titulo={c.tituloAtajos} />
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5">
      {atajos.map((a) => (
        <a href={a.href} class="overflow-hidden rounded-2xl border border-marca-100 bg-white hover:shadow-md">
          {a.imagen ? (
            <img src={a.imagen} alt={a.titulo} class="aspect-video w-full object-cover" loading="lazy" />
          ) : (
            <div class="flex aspect-video items-center justify-center bg-marca-100 text-sm text-marca-600">
              Foto pendiente
            </div>
          )}
          <div class="p-3 sm:p-4">
            <h3 class="text-sm font-semibold text-marca-900 sm:text-base">{a.titulo}</h3>
          </div>
        </a>
      ))}
      {/* Solo mobile: completa la grilla 2x2 con acceso a Contacto. */}
      <a href="/contacto" class="overflow-hidden rounded-2xl border border-marca-100 bg-white hover:shadow-md sm:hidden">
        {c.contactoImagen ? (
          <img src={c.contactoImagen} alt="Contacto" loading="lazy" class="aspect-video w-full object-cover" />
        ) : (
          <div class="flex aspect-video items-center justify-center bg-marca-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-8 w-8 text-white">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
          </div>
        )}
        <div class="p-3 sm:p-4">
          <h3 class="text-sm font-semibold text-marca-900 sm:text-base">Contacto</h3>
        </div>
      </a>
    </div>
  </section>

  <!-- Texto de presentación -->
  <section class="mx-auto max-w-3xl px-4 py-12 text-center sm:py-20">
    <p class="text-xl font-medium leading-relaxed text-marca-700 sm:text-2xl">
      {c.presentacionP1}
    </p>
    <p class="mt-4 text-base text-marca-900/70 sm:text-lg">
      {c.presentacionP2}
    </p>
  </section>

  <!-- Los más pedidos (cierre comercial) -->
  <section class="mx-auto max-w-6xl px-4 pb-12 sm:pb-20">
    <TituloSeccion titulo={c.tituloDestacados} />
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
      {destacados.map((p) => <ProductCard producto={p} />)}
    </div>
  </section>
</Layout>
