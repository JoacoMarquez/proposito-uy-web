---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { destacados, categorias } from "../data/productos";

const categoriasLista = [
  { slug: "secos", ...categorias.secos },
  { slug: "humedos", ...categorias.humedos },
  { slug: "barras", ...categorias.barras },
];

const atajos = [
  { href: "/recetario", titulo: "Recetario" },
  { href: "/retornables", titulo: "Retornables" },
  { href: "/preguntas", titulo: "Preguntas" },
];
---

<Layout>
  <!-- Banner principal -->
  <section class="bg-marca-600 text-white">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-20">
      <p class="rounded-full bg-acento/20 px-3 py-1 text-sm">Propósito UY</p>
      <h1 class="max-w-3xl text-3xl font-bold leading-tight sm:text-5xl">
        Elaboramos alimentos reales, honestos y nutritivos, pensados para acompañarte en el día a día.
      </h1>
      <a href="/tienda" class="rounded-full bg-white px-6 py-3 font-medium text-marca-700 hover:bg-marca-50">
        Ver catálogo
      </a>
    </div>
  </section>

  <!-- Los más pedidos -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-marca-700">Los más pedidos por ustedes</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {destacados.map((p) => <ProductCard producto={p} />)}
    </div>
  </section>

  <!-- Categorías de productos -->
  <section class="bg-marca-50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-2xl font-bold text-marca-700">Categorías</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-3">
        {categoriasLista.map((c) => (
          <a
            href={`/tienda/${c.slug}`}
            class="rounded-2xl border border-marca-100 bg-white p-6 transition-shadow hover:shadow-md"
          >
            <h3 class="text-lg font-semibold text-marca-900">{c.nombre}</h3>
            <p class="mt-1 text-sm text-marca-900/70">{c.descripcion}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Cierre emocional -->
  <section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="text-2xl font-medium leading-relaxed text-marca-700">
      Queremos alimentarte en tu rutina, en tus momentos de descanso, en tus desayunos, tus meriendas
      y también cuando no tenés tiempo de sentarte a comer.
    </p>
    <p class="mt-4 text-lg text-marca-900/70">
      Nuestros productos están pensados para acompañarte en lo cotidiano, con soluciones prácticas,
      ricas y reales.
    </p>
  </section>

  <!-- Atajos -->
  <section class="mx-auto max-w-6xl px-4 pb-20">
    <h2 class="text-2xl font-bold text-marca-700">Atajos</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-3">
      {atajos.map((a) => (
        <a href={a.href} class="overflow-hidden rounded-2xl border border-marca-100 bg-white hover:shadow-md">
          <div class="flex aspect-video items-center justify-center bg-marca-100 text-sm text-marca-600">
            Foto pendiente
          </div>
          <div class="p-4">
            <h3 class="font-semibold text-marca-900">{a.titulo}</h3>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
