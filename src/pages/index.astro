---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import CategoriaCard from "../components/CategoriaCard.astro";
import TituloSeccion from "../components/TituloSeccion.astro";
import { getDestacados, getCategorias } from "../db/queries";

const destacados = await getDestacados();
const categoriasLista = await getCategorias();

const atajos = [
  { href: "/recetario", titulo: "Recetario" },
  { href: "/retornables", titulo: "Retornables" },
  { href: "/preguntas", titulo: "Preguntas" },
];
---

<Layout>
  <!-- Hero principal: placa de marca + frase principal + CTA -->
  <section class="bg-marca-100 text-center">
    <img
      src="/inicio/portada.webp"
      alt="Propósito — cuidamos lo que comés"
      class="h-64 w-full object-cover sm:h-80 lg:h-96"
    />
    <div class="px-4 pb-14">
      <h1 class="mx-auto max-w-3xl pt-8 text-2xl font-bold leading-tight text-marca-700 sm:text-3xl">
        Elaboramos alimentos artesanales para acompañar tu rutina.
      </h1>
      <a
        href="/tienda"
        class="mt-8 inline-block rounded-full bg-marca-600 px-8 py-3 font-medium text-white hover:bg-marca-700"
      >
        Ver catálogo
      </a>
    </div>
  </section>

  <!-- Categorías de productos -->
  <section class="bg-marca-50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <TituloSeccion titulo="Categorías" />
      <div class="mt-6 grid gap-5 sm:grid-cols-3">
        {categoriasLista.map((c) => (
          <CategoriaCard slug={c.slug} nombre={c.nombre} descripcion={c.descripcion} imagen={c.imagen} />
        ))}
      </div>
    </div>
  </section>

  <!-- Atajos -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <TituloSeccion titulo="Atajos" />
    <div class="mt-6 grid gap-5 sm:grid-cols-3">
      {atajos.map((a) => (
        <a href={a.href} class="overflow-hidden rounded-2xl border border-marca-100 bg-white hover:shadow-md">
          <div class="flex aspect-video items-center justify-center bg-marca-100 text-sm text-marca-600">
            Foto pendiente
          </div>
          <div class="p-4">
            <h3 class="font-semibold text-marca-900">{a.titulo}</h3>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Texto de presentación -->
  <section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="text-2xl font-medium leading-relaxed text-marca-700">
      Queremos resolver tus desayunos, meriendas y picadas con alimentos que tu cuerpo pueda reconocer.
    </p>
    <p class="mt-4 text-lg text-marca-900/70">
      Nuestras elaboraciones nacen de una decisión innegociable: usar únicamente ingredientes naturales.
    </p>
  </section>

  <!-- Los más pedidos (cierre comercial) -->
  <section class="mx-auto max-w-6xl px-4 pb-20">
    <TituloSeccion titulo="Los más pedidos por ustedes" />
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {destacados.map((p) => <ProductCard producto={p} />)}
    </div>
  </section>
</Layout>
