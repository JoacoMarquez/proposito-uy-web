---
export const prerender = false;
// Ruta estática: tiene prioridad sobre [categoria].astro, así que no colisiona.
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import TituloSeccion from "../../components/TituloSeccion.astro";
import { getProductosSeccion, getCategorias } from "../../db/queries";

const [productos, cats] = await Promise.all([getProductosSeccion("cultivo"), getCategorias("cultivo")]);
const grupos = cats
  .map((cat) => ({
    cat,
    items: productos.filter((p) => p.categoriaSlug === cat.slug).sort((a, b) => a.ordenCategoria - b.ordenCategoria),
  }))
  .filter((g) => g.items.length > 0);
---

<Layout titulo="Catálogo de Cultivo" descripcion="Todos los productos de Cultivo: plantines, insumos y guías.">
  <section class="mx-auto max-w-6xl px-4 py-16">
    <nav class="text-sm text-marca-600">
      <a href="/cultivo" class="hover:underline">Cultivo</a> / <span>Catálogo</span>
    </nav>
    <h1 class="mt-2 text-3xl font-bold text-marca-700">Catálogo completo</h1>

    {grupos.length === 0 && (
      <p class="mt-8 rounded-2xl border border-marca-100 bg-white p-8 text-center text-marca-900/60">
        Pronto vas a encontrar productos de Cultivo acá.
      </p>
    )}

    {grupos.map((g) => (
      <div class="mt-10">
        <TituloSeccion titulo={g.cat.nombre} />
        <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((p) => <ProductCard producto={p} tipo={g.cat.tipo} />)}
        </div>
      </div>
    ))}
  </section>
</Layout>
