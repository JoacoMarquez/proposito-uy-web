---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCategoria, getProductosPorCategoria } from "../../db/queries";

const { categoria } = Astro.params;
const info = categoria ? await getCategoria(categoria) : undefined;
if (!info) return Astro.redirect("/cultivo");
if (info.seccion !== "cultivo") return Astro.redirect(`/tienda/${info.slug}`);

const items = await getProductosPorCategoria(info.slug);
// Bloque editorial opcional: solo aparece si se cargó algo desde el panel.
const conEditorial = Boolean(info.descripcionGeneral || info.caracteristicas.length || info.notasCreador.length);
---

<Layout titulo={info.nombre} descripcion={info.descripcion}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <nav class="text-sm text-marca-600">
      <a href="/cultivo" class="hover:underline">Cultivo</a> / <span>{info.nombre}</span>
    </nav>
    <h1 class="mt-2 text-3xl font-bold text-marca-700">{info.nombre}</h1>
    <p class="mt-2 max-w-xl text-marca-900/70">{info.descripcion}</p>

    {items.length === 0 ? (
      <p class="mt-8 rounded-2xl border border-marca-100 bg-white p-8 text-center text-marca-900/60">
        Pronto vas a encontrar productos en esta categoría.
      </p>
    ) : (
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((p) => <ProductCard producto={p} tipo={info.tipo} />)}
      </div>
    )}

    {conEditorial && (
      <div class="mt-14 rounded-2xl border border-marca-100 bg-white p-8">
        {info.descripcionGeneral && <p class="text-lg text-marca-900/80">{info.descripcionGeneral}</p>}
        {info.caracteristicas.length > 0 && (
          <Fragment>
            <h2 class="mt-6 text-sm font-semibold uppercase tracking-wide text-marca-700">Características</h2>
            <ul class="mt-2 flex flex-wrap gap-2">
              {info.caracteristicas.map((c) => (
                <li class="rounded-full bg-marca-100 px-3 py-1 text-sm text-marca-900/80">{c}</li>
              ))}
            </ul>
          </Fragment>
        )}
        {info.notasCreador.length > 0 && (
          <Fragment>
            <h2 class="mt-6 text-sm font-semibold uppercase tracking-wide text-marca-700">Notas del creador</h2>
            <div class="mt-2 space-y-2 text-sm text-marca-900/70">
              {info.notasCreador.map((n) => <p>{n}</p>)}
            </div>
          </Fragment>
        )}
      </div>
    )}
  </section>
</Layout>
