---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import TablaContenido from "../components/TablaContenido.astro";
import { getContenido, getGrillaRetornables } from "../db/queries";

const c = await getContenido("retornables");
// Grilla automática: se arma desde las presentaciones con "frascos p/ 1 gratis"
// cargados en cada producto (panel → Productos). Un solo lugar para mantener.
const filasRetornables = await getGrillaRetornables();
const grillaTabla = {
  columnas: ["Productos", "Frascos para 1 gratis"],
  filas: filasRetornables.map((f) => [f.producto, String(f.frascos)]),
};
const acordeones = [1, 2, 3, 4, 5, 6, 7].map((n) => ({
  titulo: c[`acordeon${n}Titulo`],
  cuerpo: String(c[`acordeon${n}Cuerpo`] ?? "")
    .split("\n")
    .map((s) => s.trim())
    .filter(Boolean),
}));
---

<Layout titulo="Retornables" descripcion="Sistema de envases retornables de Propósito UY.">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-marca-700">{c.titulo}</h1>
    <p class="mt-4 text-lg text-marca-900/80">
      {c.intro}
    </p>

    <img
      src={c.heroImagen}
      alt={c.heroAlt}
      loading="lazy"
      class="mt-8 aspect-[3/2] w-full rounded-2xl object-cover"
    />

    <!-- Grilla de retornabilidad (tabla on-site) -->
    <div class="mt-8">
      <h2 class="text-lg font-semibold text-marca-700">{c.grillaTitulo}</h2>
      <p class="mt-1 mb-3 text-sm text-marca-900/70">{c.grillaDescripcion}</p>
      <TablaContenido tabla={grillaTabla} chipCol={1} />
    </div>

    <!-- Acordeones -->
    <div class="mt-10 space-y-3">
      {acordeones.map((a) => (
        <details class="group rounded-xl border border-marca-100 bg-white p-4">
          <summary class="flex cursor-pointer list-none items-center justify-between font-medium text-marca-900">
            {a.titulo}
            <span class="text-marca-500 transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="mt-3 space-y-2 text-sm text-marca-900/70">
            {a.cuerpo.map((p) => <p>{p}</p>)}
          </div>
        </details>
      ))}
    </div>
  </section>
</Layout>
