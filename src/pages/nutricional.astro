---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import TablaContenido from "../components/TablaContenido.astro";
import { getContenido } from "../db/queries";

const c = await getContenido("nutricional");
---

<Layout titulo={c.titulo} descripcion="Información nutricional de los productos de Propósito UY.">
  <section class="mx-auto max-w-5xl px-4 py-16">
    <a href="/preguntas" class="text-sm text-marca-700 hover:underline">← Volver a Preguntas</a>
    <h1 class="mt-2 text-3xl font-bold text-marca-700">{c.titulo}</h1>
    {c.intro && <p class="mt-2 max-w-2xl text-marca-900/70">{c.intro}</p>}
    <div class="mt-8">
      <TablaContenido tabla={c.tabla} tituloCol={1} grupoCol={0} />
    </div>
  </section>
</Layout>
