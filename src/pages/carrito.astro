---
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Carrito" descripcion="Tu carrito de compras en Propósito UY." noindex>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-marca-700">Tu carrito</h1>

    <div id="vacio" class="mt-8 hidden rounded-2xl border border-marca-100 bg-white p-8 text-center">
      <p class="text-marca-900/70">Tu carrito está vacío.</p>
      <a href="/tienda" class="mt-4 inline-block rounded-full bg-marca-600 px-5 py-2.5 font-medium text-white hover:bg-marca-700">
        Ir a la tienda
      </a>
    </div>

    <div id="contenido" class="mt-8 hidden">
      <div id="items" class="space-y-3"></div>

      <div class="mt-6 rounded-2xl border border-marca-100 bg-white p-6">
        <div class="flex items-center justify-between text-lg">
          <span class="font-medium text-marca-700">Subtotal</span>
          <span id="subtotal" class="font-bold text-marca-900"></span>
        </div>
        <p class="mt-1 text-sm text-marca-900/60">El costo de envío se calcula en el checkout.</p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a href="/tienda" class="rounded-full border border-marca-300 px-5 py-2.5 text-center font-medium text-marca-700 hover:bg-marca-50">
            Seguir comprando
          </a>
          <a href="/checkout" class="flex-1 rounded-full bg-marca-600 px-5 py-2.5 text-center font-medium text-white hover:bg-marca-700">
            Finalizar pedido
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { getCarrito, setCantidad, quitar, subtotal, formatoPrecio } from "../scripts/cart";

  const itemsEl = document.getElementById("items")!;
  const vacioEl = document.getElementById("vacio")!;
  const contenidoEl = document.getElementById("contenido")!;
  const subtotalEl = document.getElementById("subtotal")!;

  function render() {
    const items = getCarrito();
    vacioEl.classList.toggle("hidden", items.length > 0);
    contenidoEl.classList.toggle("hidden", items.length === 0);
    subtotalEl.textContent = formatoPrecio(subtotal());

    itemsEl.innerHTML = "";
    for (const i of items) {
      const row = document.createElement("div");
      row.className = "flex items-center gap-4 rounded-2xl border border-marca-100 bg-white p-4";
      row.innerHTML = `
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl bg-marca-50 text-xs text-marca-300">Foto</div>
        <div class="flex-1">
          <p class="font-medium text-marca-900">${i.nombre}</p>
          <p class="text-sm text-marca-600">${i.presentacion} · ${formatoPrecio(i.precio)}</p>
        </div>
        <input type="number" min="0" value="${i.cantidad}" class="qty w-16 rounded-lg border border-marca-300 px-2 py-1 text-center" />
        <p class="w-24 text-right font-medium text-marca-900">${formatoPrecio(i.precio * i.cantidad)}</p>
        <button class="quitar text-sm text-red-600 hover:underline">Quitar</button>
      `;
      row.querySelector(".qty")!.addEventListener("change", (e) => {
        setCantidad(i.slug, i.presentacion, Math.max(0, Number((e.target as HTMLInputElement).value)));
        render();
      });
      row.querySelector(".quitar")!.addEventListener("click", () => {
        quitar(i.slug, i.presentacion);
        render();
      });
      itemsEl.appendChild(row);
    }
  }

  render();
</script>
