---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { getPreguntas } from "../db/queries";
import { site } from "../data/site";

const preguntas = await getPreguntas();
const labels: Record<string, string> = {
  pedidos: "Pedidos",
  elaboracion: "Elaboración",
  nutricional: "Nutricional",
};
const orden = ["pedidos", "elaboracion", "nutricional"];
const tabs = [{ id: "todas", label: "Todas" }, ...orden.map((t) => ({ id: t, label: labels[t] }))];
// Ordenar preguntas según el orden de temas
preguntas.sort((a, b) => orden.indexOf(a.tema) - orden.indexOf(b.tema));
---

<Layout titulo="Preguntas" descripcion="Lo más consultado: pedidos, elaboración y nutrición.">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-marca-700">Preguntas</h1>
    <p class="mt-2 text-marca-900/70">
      Acá reunimos lo más consultado por ustedes: cómo funcionan los pedidos, cómo elaboramos nuestros
      productos y cómo leer la información nutricional. Todo claro, directo y simple.
    </p>

    <!-- Tabs / filtros -->
    <div class="mt-8 flex flex-wrap gap-2" role="tablist">
      {tabs.map((tab, i) => (
        <button
          type="button"
          data-tab={tab.id}
          class:list={[
            "tab-btn rounded-full px-4 py-1.5 text-sm font-medium transition-colors",
            i === 0 ? "bg-marca-600 text-white" : "bg-marca-100 text-marca-700 hover:bg-marca-300/60",
          ]}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <!-- Link a tablas nutricionales (tema nutricional) -->
    <a
      href={site.tablasNutricionalesUrl}
      data-tema="nutricional"
      class="faq-item mt-6 flex items-center justify-between rounded-xl border border-marca-100 bg-marca-50 p-4 text-sm font-medium text-marca-700 hover:bg-marca-100"
    >
      Ver tablas nutricionales actualizadas
      <span aria-hidden="true">→</span>
    </a>

    <!-- Lista de preguntas -->
    <div class="mt-4 space-y-3">
      {preguntas.map((p) => (
        <details class="faq-item group rounded-xl border border-marca-100 bg-white p-4" data-tema={p.tema}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
            <span>
              <span class="block font-medium text-marca-900">{p.pregunta}</span>
              <span class="mt-1 block text-sm text-marca-500">{p.microResumen}</span>
            </span>
            <span class="mt-0.5 text-marca-500 transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="mt-3 space-y-2 text-sm text-marca-900/70">
            {p.desarrollo.map((d) => <p>{d}</p>)}
          </div>
        </details>
      ))}
    </div>
  </section>
</Layout>

<script>
  const botones = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const items = document.querySelectorAll<HTMLElement>(".faq-item");

  function filtrar(tab: string) {
    items.forEach((el) => {
      el.hidden = tab !== "todas" && el.dataset.tema !== tab;
    });
    botones.forEach((b) => {
      const esActivo = b.dataset.tab === tab;
      b.classList.toggle("bg-marca-600", esActivo);
      b.classList.toggle("text-white", esActivo);
      b.classList.toggle("bg-marca-100", !esActivo);
      b.classList.toggle("text-marca-700", !esActivo);
      b.classList.toggle("hover:bg-marca-300/60", !esActivo);
    });
  }

  botones.forEach((b) => b.addEventListener("click", () => filtrar(b.dataset.tab!)));
</script>
