---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCategoria, getProductosPorCategoria } from "../../db/queries";

const { categoria } = Astro.params;
const info = categoria ? await getCategoria(categoria) : undefined;
if (!info) return Astro.redirect("/tienda");

const items = await getProductosPorCategoria(info.slug);
---

<Layout titulo={info.nombre} descripcion={info.descripcion}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <nav class="text-sm text-marca-600">
      <a href="/tienda" class="hover:underline">Tienda</a> / <span>{info.nombre}</span>
    </nav>
    <h1 class="mt-2 text-3xl font-bold text-marca-700">{info.nombre}</h1>
    <p class="mt-2 max-w-xl text-marca-900/70">{info.descripcion}</p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((p) => <ProductCard producto={p} />)}
    </div>

    <!-- Bloque editorial de categoría -->
    <div class="mt-14 rounded-2xl border border-marca-100 bg-white p-8">
      <p class="text-lg text-marca-900/80">{info.descripcionGeneral}</p>

      <h2 class="mt-6 text-sm font-semibold uppercase tracking-wide text-marca-700">Características</h2>
      <ul class="mt-2 flex flex-wrap gap-2">
        {info.caracteristicas.map((c) => (
          <li class="rounded-full bg-marca-100 px-3 py-1 text-sm text-marca-900/80">{c}</li>
        ))}
      </ul>

      <h2 class="mt-6 text-sm font-semibold uppercase tracking-wide text-marca-700">Notas del creador</h2>
      <div class="mt-2 space-y-2 text-sm text-marca-900/70">
        {info.notasCreador.map((n) => <p>{n}</p>)}
      </div>
    </div>
  </section>
</Layout>
