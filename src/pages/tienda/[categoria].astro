---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { categorias, productosPorCategoria } from "../../data/productos";
import type { Categoria } from "../../data/productos";

export function getStaticPaths() {
  return (Object.keys(categorias) as Categoria[]).map((cat) => ({
    params: { categoria: cat },
  }));
}

const { categoria } = Astro.params as { categoria: Categoria };
const info = categorias[categoria];
const items = productosPorCategoria(categoria);
---

<Layout titulo={info.nombre} descripcion={info.descripcion}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <nav class="text-sm text-marca-600">
      <a href="/tienda" class="hover:underline">Tienda</a> / <span>{info.nombre}</span>
    </nav>
    <h1 class="mt-2 text-3xl font-bold text-marca-700">{info.nombre}</h1>
    <p class="mt-2 max-w-xl text-marca-900/70">{info.descripcion}</p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((p) => <ProductCard producto={p} />)}
    </div>

    <!-- Información adicional de la categoría (del documento base) -->
    <div class="mt-12 rounded-2xl border border-marca-100 bg-white p-6 text-marca-900/70">
      <h2 class="font-semibold text-marca-700">Información adicional</h2>
      <p class="mt-2 text-sm">Texto pendiente: detalles de conservación, ingredientes o presentación de {info.nombre}.</p>
    </div>
  </section>
</Layout>
