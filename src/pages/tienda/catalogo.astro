---
export const prerender = false;
// Ruta estática: tiene prioridad sobre [categoria].astro, así que no colisiona.
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import TituloSeccion from "../../components/TituloSeccion.astro";
import { getProductos, getCategorias } from "../../db/queries";

const [productos, cats] = await Promise.all([getProductos(), getCategorias()]);
---

<Layout titulo="Catálogo" descripcion="Todos los productos de Propósito UY.">
  <section class="mx-auto max-w-6xl px-4 py-16">
    <nav class="text-sm text-marca-600">
      <a href="/tienda" class="hover:underline">Tienda</a> / <span>Catálogo</span>
    </nav>
    <h1 class="mt-2 text-3xl font-bold text-marca-700">Catálogo completo</h1>

    {cats.map((cat) => (
      <div class="mt-10">
        <TituloSeccion titulo={cat.nombre} />
        <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {productos
            .filter((p) => p.categoriaSlug === cat.slug)
            .sort((a, b) => a.ordenCategoria - b.ordenCategoria)
            .map((p) => <ProductCard producto={p} />)}
        </div>
      </div>
    ))}
  </section>
</Layout>
