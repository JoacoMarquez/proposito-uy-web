---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import CategoriaCard from "../../components/CategoriaCard.astro";
import { getCategorias } from "../../db/queries";

const lista = await getCategorias();
---

<Layout titulo="Tienda" descripcion="Conocé todos los productos de Propósito UY.">
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-bold text-marca-700">Tienda</h1>
    <p class="mt-2 max-w-xl text-marca-900/70">Elegí una categoría o mirá el catálogo completo.</p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {lista.map((c) => (
        <CategoriaCard slug={c.slug} nombre={c.nombre} descripcion={c.descripcion} imagen={c.imagen} />
      ))}
      <a href="/tienda/catalogo" class="rounded-2xl border border-marca-100 bg-marca-100 p-6 hover:shadow-md sm:col-span-2">
        <h2 class="text-xl font-semibold text-marca-900">Catálogo completo</h2>
        <p class="mt-1 text-sm text-marca-900/70">Todos los productos en un solo lugar.</p>
      </a>
    </div>
  </section>
</Layout>
