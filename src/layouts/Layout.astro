---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import FavoritosInit from "../components/FavoritosInit.astro";
import { site } from "../data/site";

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Imagen para previews al compartir (Open Graph). Por defecto, la del sitio. */
  imagen?: string;
  /** Si true, pide a los buscadores no indexar la página (páginas privadas). */
  noindex?: boolean;
}

const { titulo, descripcion, imagen, noindex = false } = Astro.props;
const tituloFinal = titulo ? `${titulo} · ${site.nombre}` : site.nombre;
const desc = descripcion ?? "Cuidamos lo que comés.";
// URLs absolutas estables (independientes del host) para canonical y Open Graph.
const baseUrl = `https://${site.dominio}`;
const canonical = new URL(Astro.url.pathname, baseUrl).href;
// Sin imagen propia, usamos la tarjeta institucional de marca (1200×630).
const usaOgMarca = !imagen;
const imagenOg = new URL(imagen ?? site.ogImagen, baseUrl).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#2d392c" />
    <title>{tituloFinal}</title>
    <meta name="description" content={desc} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <!-- Open Graph -->
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:alt" content={site.nombre} />
    {usaOgMarca && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:locale" content="es_UY" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloFinal} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={imagenOg} />
    <meta name="twitter:image:alt" content={site.nombre} />
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col font-sans">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <FavoritosInit />
  </body>
</html>
