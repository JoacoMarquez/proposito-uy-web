---
// Tarjeta de categoría: foto con overlay y nombre/descripción encima.
// Compartida entre Inicio y Tienda para mantener el mismo tratamiento visual.
interface Props {
  slug: string;
  nombre: string;
  descripcion: string;
  imagen?: string | null;
}
const { slug, nombre, descripcion, imagen } = Astro.props;
---

<a
  href={`/tienda/${slug}`}
  class="group relative block aspect-square overflow-hidden rounded-2xl bg-marca-200"
>
  {imagen && (
    <img
      src={imagen}
      alt={`Categoría ${nombre}`}
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 p-5">
    <h3 class="text-lg font-semibold text-white">{nombre}</h3>
    <p class="mt-1 text-sm text-white/85">{descripcion}</p>
  </div>
</a>
