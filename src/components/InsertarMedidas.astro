---
// Barra de atajos para el editor de recetas: inserta fracciones y unidades de
// cocina en la posición del cursor de un textarea. `target` = id del textarea.
interface Props {
  target: string;
}
const { target } = Astro.props;
const fracciones = ["½", "⅓", "⅔", "¼", "¾", "⅛", "⅜", "⅝", "⅞"];
// Se insertan con un espacio adelante para encadenar con el número (ej: "130 g")
// sin dejar espacio final, así cerrar paréntesis queda limpio: "(⅓ taza)".
const unidades = ["g", "kg", "ml", "l", "taza", "cda", "cdta", "unidad", "pizca", "c/n"];
const btn =
  "rounded-md border border-marca-200 bg-marca-50 px-2 py-1 text-sm font-medium leading-none text-marca-700 transition hover:bg-marca-100";
---

<div data-insertar={target} class="mt-1 flex flex-wrap items-center gap-1.5">
  {fracciones.map((t) => (
    <button type="button" data-token={t} class={btn}>{t}</button>
  ))}
  <span class="mx-0.5 h-5 w-px bg-marca-200"></span>
  {unidades.map((t) => (
    <button type="button" data-token={` ${t}`} class={btn}>{t}</button>
  ))}
</div>

<script>
  function insertarEn(ta: HTMLTextAreaElement, token: string) {
    const start = ta.selectionStart ?? ta.value.length;
    const end = ta.selectionEnd ?? ta.value.length;
    // Evita espacios dobles si ya hay uno antes/después del cursor.
    let tok = token;
    if (tok.startsWith(" ") && ta.value[start - 1] === " ") tok = tok.slice(1);
    if (tok.endsWith(" ") && ta.value[end] === " ") tok = tok.slice(0, -1);
    ta.value = ta.value.slice(0, start) + tok + ta.value.slice(end);
    const pos = start + tok.length;
    ta.selectionStart = ta.selectionEnd = pos;
    ta.focus();
    ta.dispatchEvent(new Event("input", { bubbles: true })); // marca el form como sucio
  }

  function setup(bar: HTMLElement) {
    if (bar.dataset.init) return;
    bar.dataset.init = "1";
    const id = bar.dataset.insertar!;
    const ta = document.getElementById(id) as HTMLTextAreaElement | null;
    if (!ta) return;
    bar.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest("[data-token]") as HTMLElement | null;
      if (b) insertarEn(ta, b.dataset.token ?? "");
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-insertar]").forEach(setup);
  }
  init();
  document.addEventListener("astro:after-swap", init);
</script>
