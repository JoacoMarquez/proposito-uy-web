---
import type { ProductoFull } from "../db/queries";
import { nombreCompleto, precioDesde, formatoPrecio } from "../db/queries";

interface Props {
  producto: ProductoFull;
}

const { producto } = Astro.props;
const nombre = nombreCompleto(producto);
const desde = producto.presentaciones.length > 1;
const agotado = !producto.disponible;
---

<a
  href={`/producto/${producto.slug}`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-marca-100 bg-white shadow-sm transition-shadow hover:shadow-md"
>
  <div class="relative flex aspect-square items-center justify-center bg-marca-50 text-marca-300">
    {producto.imagen ? (
      <img src={producto.imagen} alt={nombre} class="h-full w-full object-cover" />
    ) : (
      <span class="text-sm">Foto pendiente</span>
    )}
    {agotado && (
      <span class="absolute left-3 top-3 rounded-full bg-marca-900/80 px-2 py-1 text-xs font-medium text-white">
        Agotado
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    <h3 class="font-semibold text-marca-900">{producto.nombre}</h3>
    <p class="text-sm text-marca-600">{producto.variante}</p>
    <p class="mt-2 font-medium text-marca-900">
      {desde && <span class="text-sm font-normal text-marca-500">desde </span>}
      {formatoPrecio(precioDesde(producto))}
    </p>
    <span class="mt-3 inline-flex w-fit items-center text-sm font-medium text-marca-700 group-hover:underline">
      Ver producto →
    </span>
  </div>
</a>
