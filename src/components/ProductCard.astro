---
import type { ProductoFull } from "../db/queries";
import { nombreCompleto, precioDesde, formatoPrecio } from "../db/queries";
import FavoritoBoton from "./FavoritoBoton.astro";

interface Props {
  producto: ProductoFull;
}

const { producto } = Astro.props;
const nombre = nombreCompleto(producto);
const desde = producto.presentaciones.length > 1;
const agotado = !producto.disponible;
const precio = precioDesde(producto);
---

<div
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-marca-100 bg-white shadow-sm transition-shadow hover:shadow-md"
>
  <a href={`/producto/${producto.slug}`} class="flex flex-1 flex-col">
    <div class="relative flex aspect-[4/3] items-center justify-center bg-marca-50 text-marca-300 sm:aspect-square">
      {producto.imagen ? (
        <img src={producto.imagen} alt={nombre} width="800" height="800" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
      ) : (
        <span class="text-sm">Foto pendiente</span>
      )}
      {agotado && (
        <span class="absolute left-3 top-3 rounded-full bg-marca-900/80 px-2 py-1 text-xs font-medium text-white">
          Agotado
        </span>
      )}
    </div>
    <div class="flex flex-1 flex-col gap-0.5 p-3 sm:gap-1 sm:p-4">
      <h3 class="text-sm font-semibold text-marca-900 sm:text-base">{producto.nombre}</h3>
      <p class="text-xs text-marca-600 sm:text-sm">{producto.variante}</p>
      <p class="mt-1 font-medium text-marca-900 sm:mt-2">
        {desde && <span class="text-sm font-normal text-marca-500">desde </span>}
        {formatoPrecio(precio)}
      </p>
      <span class="mt-3 hidden w-fit items-center text-sm font-medium text-marca-700 group-hover:underline sm:inline-flex">
        Ver producto →
      </span>
    </div>
  </a>

  <FavoritoBoton
    slug={producto.slug}
    nombre={nombre}
    variante={producto.variante}
    imagen={producto.imagen ?? undefined}
    precioDesde={precio}
    desde={desde}
    class="absolute right-3 top-3"
  />
</div>
