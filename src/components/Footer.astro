---
import { nav, site, whatsappLink } from "../data/site";
import { navLegales } from "../data/legales";
import { getContenido } from "../db/queries";

const c = await getContenido("footer");
const aj = await getContenido("ajustes");
---

<footer class="mt-20 border-t border-marca-100 bg-marca-50">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-3">
    <div>
      <p class="text-lg font-bold text-marca-700">{site.nombre}</p>
      <p class="mt-2 text-sm text-marca-900/70">{c.tagline}</p>

      <form id="newsletter-form" class="mt-4" novalidate>
        <label for="nl-email" class="text-sm font-medium text-marca-700">{c.newsletterLabel}</label>
        <div class="mt-2 flex gap-2">
          <input
            id="nl-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={c.newsletterPlaceholder}
            class="min-w-0 flex-1 rounded-full border border-marca-300 bg-white px-4 py-2 text-sm text-marca-900 placeholder:text-marca-300"
          />
          <button
            type="submit"
            class="shrink-0 rounded-full bg-marca-600 px-4 py-2 text-sm font-medium text-white hover:bg-marca-700 disabled:opacity-60"
          >
            {c.newsletterBoton}
          </button>
        </div>
        <p id="nl-msg" class="mt-2 text-xs" role="status" hidden></p>
      </form>
    </div>

    <nav class="flex flex-col gap-1 text-sm">
      {nav.map((item) => (
        <a href={item.href} class="text-marca-700 hover:underline">{item.label}</a>
      ))}
    </nav>

    <div class="flex flex-col gap-2 text-sm">
      <a href={whatsappLink()} class="font-medium text-marca-700 hover:underline">WhatsApp</a>
      <a href={aj.instagram} class="text-marca-700 hover:underline">Instagram</a>
    </div>
  </div>
  <div class="border-t border-marca-100 px-4 py-4 text-center text-xs text-marca-900/60">
    <p>{c.copyright}</p>
    <p class="mt-1">{c.fraseFinal}</p>
    <nav class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
      {navLegales.map((item) => (
        <a href={item.href} class="text-marca-700 hover:underline">{item.label}</a>
      ))}
      <button type="button" data-cookie-settings class="text-marca-700 underline hover:no-underline">
        Configurar cookies
      </button>
    </nav>
  </div>
</footer>

<script>
  // El footer se vuelve a renderizar en cada navegación (View Transitions),
  // así que reconectamos el formulario en cada carga de página.
  function setupNewsletter() {
    const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
    if (!form) return;
    const input = document.getElementById("nl-email") as HTMLInputElement | null;
    const msg = document.getElementById("nl-msg") as HTMLParagraphElement | null;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    function mostrar(texto: string, ok: boolean) {
      if (!msg) return;
      msg.textContent = texto;
      msg.hidden = false;
      msg.className = "mt-2 text-xs " + (ok ? "text-marca-700" : "text-red-600");
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = (input?.value ?? "").trim();
      if (!email) {
        mostrar("Ingresá tu email.", false);
        return;
      }
      if (btn) btn.disabled = true;
      try {
        const res = await fetch("/api/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();
        if (res.ok) {
          mostrar(data.mensaje ?? "¡Listo!", true);
          form.reset();
        } else {
          mostrar(data.error ?? "No pudimos suscribirte.", false);
        }
      } catch {
        mostrar("Error de conexión. Probá de nuevo.", false);
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }

  document.addEventListener("astro:page-load", setupNewsletter);
</script>
