---
// Render público de una tabla editable del CMS: { columnas, filas }.
// Estilo de marca, con scroll horizontal en mobile para que no se rompa.
interface Tabla {
  columnas?: string[];
  filas?: string[][];
}
interface Props {
  tabla?: Tabla | null;
  // Para las tarjetas (mobile): qué columna es el título destacado de cada
  // tarjeta, y cuál es la columna de "grupo" (ej. Categoría) que se arrastra
  // hacia abajo cuando viene vacía. Por defecto, título = primera columna.
  tituloCol?: number;
  grupoCol?: number;
  // Columna cuyo valor se muestra como "chip" destacado (ej. la cantidad).
  chipCol?: number;
}
const { tabla, tituloCol = 0, grupoCol, chipCol } = Astro.props;
const chipCls =
  "inline-flex items-center rounded-full bg-marca-600 px-3 py-0.5 text-sm font-semibold text-white";
const columnas = tabla?.columnas ?? [];
const filas = tabla?.filas ?? [];
const hay = columnas.length > 0 && filas.length > 0;

// Grupo (categoría) efectivo por fila: arrastra el último valor no vacío.
let ultimoGrupo = "";
const gruposPorFila = filas.map((fila) => {
  if (grupoCol !== undefined && String(fila[grupoCol] ?? "").trim()) {
    ultimoGrupo = String(fila[grupoCol]);
  }
  return grupoCol !== undefined ? ultimoGrupo : "";
});
---

{hay ? (
  <>
    {/* Desktop / tablet: tabla */}
    <div class="hidden overflow-hidden rounded-2xl border border-marca-100 md:block">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="bg-marca-600 text-white">
            {columnas.map((c, j) => (
              <th class:list={["break-words px-2.5 py-2.5 align-bottom font-semibold", j === chipCol && "text-center"]}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {filas.map((fila, i) => (
            <tr class:list={[i % 2 === 1 ? "bg-marca-50" : "bg-white", "border-t border-marca-100"]}>
              {columnas.map((_, j) => (
                <td class:list={["break-words px-2.5 py-2 align-top text-marca-900/80", j === chipCol && "text-center"]}>
                  {j === chipCol && fila[j] ? <span class={chipCls}>{fila[j]}</span> : (fila[j] ?? "")}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* Mobile: tarjetas (una por fila) */}
    <div class="space-y-3 md:hidden">
      {filas.map((fila, idx) => (
        <div class="overflow-hidden rounded-2xl border border-marca-100 bg-white">
          <div class="border-b border-marca-100 bg-marca-50 px-4 py-2.5">
            {gruposPorFila[idx] && (
              <p class="text-xs font-semibold uppercase tracking-wide text-marca-500">{gruposPorFila[idx]}</p>
            )}
            <p class="font-semibold text-marca-900">{fila[tituloCol]}</p>
          </div>
          {columnas.map((col, j) =>
            j !== tituloCol && j !== grupoCol && fila[j] ? (
              <div class="flex items-center justify-between gap-4 border-b border-marca-100 px-4 py-2 text-sm last:border-0">
                <span class="text-marca-500">{col}</span>
                {j === chipCol ? (
                  <span class={chipCls}>{fila[j]}</span>
                ) : (
                  <span class="text-right font-medium text-marca-900">{fila[j]}</span>
                )}
              </div>
            ) : null,
          )}
        </div>
      ))}
    </div>
  </>
) : (
  <p class="rounded-xl border border-marca-100 bg-marca-50 p-4 text-sm text-marca-900/60">
    Todavía no hay datos cargados en esta tabla.
  </p>
)}
