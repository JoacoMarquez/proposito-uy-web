---
import { nav, site } from "../data/site";
const path = Astro.url.pathname;
// Acceso directo al panel: solo se muestra si el visitante está logueado como admin.
const admin = Astro.locals.adminUser;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
// En Inicio (solo desktop) se oculta la marca del header y el nav va centrado;
// la marca aparece con animación (View Transitions) al navegar a otra página.
const isHome = path === "/";
---

<header class="sticky top-0 z-50 border-b border-marca-100 bg-crema/90 backdrop-blur">
  <div class="relative mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <!-- Izquierda: botón Menú (mobile) y, fuera de Inicio, la marca (desktop) -->
    <div class="flex items-center">
      <!-- Menú mobile simple (detalle nativo, sin JS) -->
      <details class="relative md:hidden">
        <summary class="cursor-pointer list-none rounded-md border border-marca-300 px-3 py-1.5 text-sm font-medium text-marca-700">
          Menú
        </summary>
        <nav class="absolute left-0 z-50 mt-2 flex w-44 flex-col rounded-lg border border-marca-100 bg-crema p-2 shadow-lg">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "rounded-md px-3 py-2 text-sm",
                isActive(item.href) ? "bg-marca-100 font-semibold" : "hover:bg-marca-50",
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </details>

      <!-- Desktop fuera de Inicio: marca a la izquierda (aparece con animación al navegar) -->
      {!isHome && (
        <a href="/" transition:name="site-logo" class="hidden items-center gap-2 text-lg font-bold tracking-tight text-marca-700 md:flex">
          <span>{site.nombre}</span>
          <img src="/marca/proposito-isotipo.webp" alt="" width="600" height="600" class="h-6 w-6" />
        </a>
      )}
    </div>

    <!-- Centro: en mobile la marca SIEMPRE centrada; en desktop Inicio, el nav centrado -->
    <a href="/" class="absolute left-1/2 flex -translate-x-1/2 items-center gap-1.5 whitespace-nowrap text-base font-bold tracking-tight text-marca-700 md:hidden">
      <span>{site.nombre}</span>
      <img src="/marca/proposito-isotipo.webp" alt="" width="600" height="600" class="h-5 w-5" />
    </a>
    {isHome && (
      <nav transition:name="site-nav" class="site-nav absolute left-1/2 hidden -translate-x-1/2 gap-1 md:flex">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-full px-3 py-1.5 text-sm font-medium transition-colors",
              isActive(item.href)
                ? "bg-marca-600 text-white"
                : "text-marca-700 hover:bg-marca-100",
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    )}

    <!-- Derecha: nav (desktop fuera de Inicio) + iconos -->
    <div class="flex items-center justify-end gap-0.5 sm:gap-2">
    {!isHome && (
      <nav transition:name="site-nav" class="site-nav mr-1 hidden gap-1 md:flex">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-full px-3 py-1.5 text-sm font-medium transition-colors",
              isActive(item.href)
                ? "bg-marca-600 text-white"
                : "text-marca-700 hover:bg-marca-100",
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    )}
    {admin && (
      <a
        href="/admin"
        class="flex items-center gap-1.5 rounded-full border border-marca-300 px-2 py-1.5 text-sm font-medium text-marca-700 transition-colors hover:bg-marca-100 sm:px-2.5"
        aria-label="Panel de administración"
        title="Panel de administración"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
        <span class="hidden sm:inline">Panel</span>
      </a>
    )}
    <a href="/favoritos" class="relative rounded-full p-1.5 text-marca-700 hover:bg-marca-100 sm:p-2" aria-label="Favoritos">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 sm:h-6 sm:w-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
      </svg>
      <span id="fav-count" class="absolute -right-0.5 -top-0.5 hidden min-w-5 rounded-full bg-marca-600 px-1 text-center text-xs font-medium text-white">0</span>
    </a>

    <a href="/cuenta" class="rounded-full p-1.5 text-marca-700 hover:bg-marca-100 sm:p-2" aria-label="Mi cuenta">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 sm:h-6 sm:w-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
      </svg>
    </a>

    <a href="/carrito" class="relative rounded-full p-1.5 text-marca-700 hover:bg-marca-100 sm:p-2" aria-label="Carrito">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 sm:h-6 sm:w-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
      </svg>
      <span id="cart-count" class="absolute -right-0.5 -top-0.5 hidden min-w-5 rounded-full bg-marca-600 px-1 text-center text-xs font-medium text-white">0</span>
    </a>
    </div>
  </div>
</header>

<script>
  import { contar } from "../scripts/cart";
  import { contar as contarFav } from "../scripts/favoritos";

  function badge(id: string, n: number) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = String(n);
    el.classList.toggle("hidden", n === 0);
  }

  // Re-consulta los badges actuales (cambian de nodo en cada navegación con
  // View Transitions) y los actualiza con el conteo vigente.
  function actualizarBadges() {
    badge("cart-count", contar());
    badge("fav-count", contarFav());
  }

  // Listeners globales (document persiste entre navegaciones): se registran una
  // sola vez al cargar el módulo, así no se duplican al navegar.
  document.addEventListener("carrito:cambio", actualizarBadges);
  document.addEventListener("favoritos:cambio", actualizarBadges);

  // En cada página (carga inicial y navegaciones SPA) re-sincronizamos los badges.
  document.addEventListener("astro:page-load", actualizarBadges);
</script>
