---
// Campo de imagen para los forms de admin (productos / recetas / contenido).
// Por defecto usa name="imagen" / fieldId="imagenFile" (compatibilidad con los
// editores de productos y recetas). Para tener VARIAS imágenes en un mismo form
// (ej. el panel de Contenido), pasá `name` y `fieldId` únicos por campo.
// - Botón verde para seleccionar archivo, con el nombre del archivo elegido.
// - Si ya hay imagen: tocarla la abre grande en un modal, desde donde se cambia.
interface Props {
  imagen?: string | null;
  alt?: string;
  name?: string; // name del hidden que guarda la URL actual
  fieldId?: string; // id/name del <input type="file">
  label?: string;
  ayuda?: string; // aclaración que se muestra junto al label
}
const {
  imagen,
  alt = "imagen",
  name = "imagen",
  fieldId = "imagenFile",
  label = "Imagen",
  ayuda,
} = Astro.props;

// Nombre a mostrar de la imagen actual: el nombre de archivo de la URL si lo
// tiene; si es una imagen subida (/api/img/<id>, sin extensión) → "Imagen cargada".
const nombreImagen = (() => {
  if (!imagen) return "Ningún archivo seleccionado";
  const base = imagen.split("?")[0].split("/").pop() ?? "";
  return base.includes(".") ? decodeURIComponent(base) : "Imagen cargada";
})();
---

<div data-img-field>
  <label class="text-sm font-medium text-marca-700">
    {label}{ayuda && <span class="font-normal text-marca-500"> — {ayuda}</span>}
  </label>

  <input type="hidden" name={name} value={imagen ?? ""} data-img-hidden />

  <div class="mt-2 flex flex-wrap items-start gap-3">
    <button
      type="button"
      data-img-open
      class:list={["shrink-0 rounded-xl", !imagen && "hidden"]}
      title="Ver imagen grande / cambiarla"
    >
      <img
        src={imagen ?? ""}
        alt={alt}
        data-img-thumb
        class="h-20 w-20 cursor-zoom-in rounded-xl border border-marca-100 object-cover transition hover:opacity-90"
      />
    </button>
    <input
      type="file"
      id={fieldId}
      name={fieldId}
      accept="image/jpeg,image/png,image/webp,image/avif,image/gif"
      class="hidden"
    />
    <div class="flex flex-col gap-2">
      <div class="flex flex-wrap items-center gap-3">
        <label
          for={fieldId}
          class="cursor-pointer rounded-full bg-marca-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-marca-700"
        >
          Seleccionar imagen
        </label>
        <span data-img-filename class="text-sm text-marca-500">{nombreImagen}</span>
      </div>
      <button
        type="button"
        data-img-remove
        class:list={[
          "self-start cursor-pointer rounded-full bg-red-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-red-700",
          !imagen && "hidden",
        ]}
      >
        Quitar imagen
      </button>
    </div>
  </div>

  <div
    data-img-modal
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
  >
      <div class="relative max-h-[90vh] max-w-[92vw] overflow-auto rounded-2xl bg-marca-50 p-3 shadow-xl">
        <img
          src={imagen ?? ""}
          alt={alt}
          data-img-big
          class="mx-auto max-h-[74vh] w-auto rounded-xl object-contain"
        />
        <div class="mt-3 flex items-center justify-center gap-3">
          <label
            for={fieldId}
            class="cursor-pointer rounded-full bg-marca-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-marca-700"
          >
            Cambiar imagen
          </label>
          <button
            type="button"
            data-img-remove
            class="rounded-full border border-red-300 px-5 py-2 text-sm font-medium text-red-600 transition hover:bg-red-50"
          >
            Quitar imagen
          </button>
          <button
            type="button"
            data-img-close
            class="rounded-full border border-marca-300 px-5 py-2 text-sm font-medium text-marca-700 transition hover:bg-marca-100"
          >
            Cerrar
          </button>
        </div>
      </div>
  </div>

  <!-- Confirmación de quitar imagen -->
  <div data-img-confirm class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl">
      <h2 class="text-lg font-semibold text-marca-900">Quitar imagen</h2>
      <p class="mt-2 text-sm text-marca-900/70">
        ¿Seguro que querés quitar esta imagen? Va a quedar sin imagen cuando guardes.
      </p>
      <div class="mt-5 flex flex-wrap justify-end gap-3">
        <button
          type="button"
          data-img-confirm-cancel
          class="rounded-full border border-marca-300 px-5 py-2 text-sm font-medium text-marca-700 transition hover:bg-marca-50"
        >
          Cancelar
        </button>
        <button
          type="button"
          data-img-confirm-yes
          class="rounded-full bg-red-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-red-700"
        >
          Quitar imagen
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Comprime la imagen en el navegador antes de subirla: máx 1200px de ancho,
  // WebP calidad 0.8. El Worker no puede procesar imágenes (sin sharp), así que
  // esta es la única barrera para que no entren fotos de ~2 MB a la base, cuya
  // transferencia es lo que agota el cupo gratuito de Neon. Los GIF se dejan
  // igual (pueden tener animación) y ante cualquier error se sube la original
  // (el server valida tipo y tamaño máximo igual que siempre).
  const COMPRIMIR_UMBRAL = 150 * 1024; // no toca archivos ya livianos
  const MAX_ANCHO = 1200;
  const CALIDAD = 0.8;

  async function comprimirImagen(f: File): Promise<File> {
    if (f.type === "image/gif" || f.size < COMPRIMIR_UMBRAL) return f;
    try {
      // imageOrientation respeta la rotación EXIF de fotos de celular; si el
      // navegador no soporta la opción, se intenta sin ella.
      const bitmap = await createImageBitmap(f, { imageOrientation: "from-image" }).catch(() =>
        createImageBitmap(f),
      );
      const escala = Math.min(1, MAX_ANCHO / bitmap.width);
      const canvas = document.createElement("canvas");
      canvas.width = Math.round(bitmap.width * escala);
      canvas.height = Math.round(bitmap.height * escala);
      canvas.getContext("2d")!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();
      const blob = await new Promise<Blob | null>((res) => canvas.toBlob(res, "image/webp", CALIDAD));
      if (!blob || blob.size >= f.size) return f; // no mejora → original
      const nombre = f.name.replace(/\.[^.]+$/, "") + ".webp";
      return new File([blob], nombre, { type: "image/webp" });
    } catch {
      return f;
    }
  }

  // Inicializa CADA campo de imagen del form de forma independiente (scoped al
  // root), así soporta varias imágenes en una misma página (panel de Contenido).
  function initOne(root: HTMLElement) {
    if (root.dataset.imgInit) return; // evita doble init (initial + after-swap)
    root.dataset.imgInit = "1";
    const file = root.querySelector<HTMLInputElement>('input[type="file"]');
    const hidden = root.querySelector<HTMLInputElement>("[data-img-hidden]");
    const nameEl = root.querySelector("[data-img-filename]");
    const modal = root.querySelector("[data-img-modal]");
    const openBtn = root.querySelector("[data-img-open]");
    const thumb = root.querySelector<HTMLImageElement>("[data-img-thumb]");
    const big = root.querySelector<HTMLImageElement>("[data-img-big]");
    const removeBtns = root.querySelectorAll<HTMLElement>("[data-img-remove]");

    const open = () => {
      if (!modal) return;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    };
    const close = () => {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    };

    if (file) {
      file.addEventListener("change", async () => {
        let f = file.files && file.files[0];
        if (f) {
          const comprimida = await comprimirImagen(f);
          if (comprimida !== f) {
            // Reemplaza el archivo del input por la versión comprimida, así el
            // form la envía sin cambiar nada del flujo de guardado.
            const dt = new DataTransfer();
            dt.items.add(comprimida);
            file.files = dt.files;
            f = comprimida;
          }
        }
        if (nameEl) nameEl.textContent = f ? f.name : "Ningún archivo seleccionado";
        if (f) {
          const url = URL.createObjectURL(f);
          if (thumb) thumb.src = url;
          if (big) big.src = url;
          (openBtn as HTMLElement | null)?.classList.remove("hidden"); // mostrar miniatura
          removeBtns.forEach((b) => b.classList.remove("hidden"));
        }
        close();
      });
    }

    // Quitar imagen: vacía el hidden (al guardar queda sin imagen), limpia el
    // archivo elegido y oculta la miniatura. No sube nada.
    const ejecutarQuitar = () => {
      if (hidden) {
        hidden.value = "";
        hidden.dispatchEvent(new Event("input", { bubbles: true })); // marca el form como sucio
      }
      if (file) file.value = "";
      if (nameEl) nameEl.textContent = "Ningún archivo seleccionado";
      (openBtn as HTMLElement | null)?.classList.add("hidden");
      removeBtns.forEach((b) => b.classList.add("hidden"));
      close();
    };

    // Confirmación con modal del sistema.
    const confirmModal = root.querySelector<HTMLElement>("[data-img-confirm]");
    const abrirConfirm = () => {
      confirmModal?.classList.remove("hidden");
      confirmModal?.classList.add("flex");
    };
    const cerrarConfirm = () => {
      confirmModal?.classList.add("hidden");
      confirmModal?.classList.remove("flex");
    };
    removeBtns.forEach((b) => b.addEventListener("click", abrirConfirm));
    root.querySelector("[data-img-confirm-yes]")?.addEventListener("click", () => {
      ejecutarQuitar();
      cerrarConfirm();
    });
    root.querySelector("[data-img-confirm-cancel]")?.addEventListener("click", cerrarConfirm);
    confirmModal?.addEventListener("click", (e) => {
      if (e.target === confirmModal) cerrarConfirm();
    });

    if (openBtn) openBtn.addEventListener("click", open);
    if (modal) {
      root.querySelectorAll("[data-img-close]").forEach((b) =>
        b.addEventListener("click", close),
      );
      modal.addEventListener("click", (e) => {
        if (e.target === modal) close();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });
    }
  }

  function initImageFields() {
    document.querySelectorAll<HTMLElement>("[data-img-field]").forEach(initOne);
  }

  initImageFields();
  document.addEventListener("astro:after-swap", initImageFields);
</script>
