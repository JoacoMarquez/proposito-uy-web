---
// Campo de imagen para los forms de admin (productos / recetas / contenido).
// Por defecto usa name="imagen" / fieldId="imagenFile" (compatibilidad con los
// editores de productos y recetas). Para tener VARIAS imágenes en un mismo form
// (ej. el panel de Contenido), pasá `name` y `fieldId` únicos por campo.
// - Botón verde para seleccionar archivo, con el nombre del archivo elegido.
// - Si ya hay imagen: tocarla la abre grande en un modal, desde donde se cambia.
interface Props {
  imagen?: string | null;
  alt?: string;
  name?: string; // name del hidden que guarda la URL actual
  fieldId?: string; // id/name del <input type="file">
  label?: string;
  ayuda?: string; // aclaración que se muestra junto al label
}
const {
  imagen,
  alt = "imagen",
  name = "imagen",
  fieldId = "imagenFile",
  label = "Imagen",
  ayuda,
} = Astro.props;

// Nombre a mostrar de la imagen actual: el nombre de archivo de la URL si lo
// tiene; si es una imagen subida (/api/img/<id>, sin extensión) → "Imagen cargada".
const nombreImagen = (() => {
  if (!imagen) return "Ningún archivo seleccionado";
  const base = imagen.split("?")[0].split("/").pop() ?? "";
  return base.includes(".") ? decodeURIComponent(base) : "Imagen cargada";
})();
---

<div data-img-field>
  <label class="text-sm font-medium text-marca-700">
    {label}{ayuda && <span class="font-normal text-marca-500"> — {ayuda}</span>}
  </label>

  <input type="hidden" name={name} value={imagen ?? ""} data-img-hidden />

  <div class="mt-2 flex flex-wrap items-start gap-3">
    {imagen && (
      <button type="button" data-img-open class="shrink-0 rounded-xl" title="Ver imagen grande / cambiarla">
        <img
          src={imagen}
          alt={alt}
          data-img-thumb
          class="h-20 w-20 cursor-zoom-in rounded-xl border border-marca-100 object-cover transition hover:opacity-90"
        />
      </button>
    )}
    <input
      type="file"
      id={fieldId}
      name={fieldId}
      accept="image/jpeg,image/png,image/webp,image/avif,image/gif"
      class="hidden"
    />
    <div class="flex flex-col gap-2">
      <div class="flex flex-wrap items-center gap-3">
        <label
          for={fieldId}
          class="cursor-pointer rounded-full bg-marca-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-marca-700"
        >
          Seleccionar imagen
        </label>
        <span data-img-filename class="text-sm text-marca-500">{nombreImagen}</span>
      </div>
      <button
        type="button"
        data-img-remove
        class:list={[
          "self-start cursor-pointer rounded-full bg-red-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-red-700",
          !imagen && "hidden",
        ]}
      >
        Quitar imagen
      </button>
    </div>
  </div>

  {imagen && (
    <div
      data-img-modal
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
    >
      <div class="relative max-h-[90vh] max-w-[92vw] overflow-auto rounded-2xl bg-marca-50 p-3 shadow-xl">
        <img
          src={imagen}
          alt={alt}
          data-img-big
          class="mx-auto max-h-[74vh] w-auto rounded-xl object-contain"
        />
        <div class="mt-3 flex items-center justify-center gap-3">
          <label
            for={fieldId}
            class="cursor-pointer rounded-full bg-marca-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-marca-700"
          >
            Cambiar imagen
          </label>
          <button
            type="button"
            data-img-remove
            class="rounded-full border border-red-300 px-5 py-2 text-sm font-medium text-red-600 transition hover:bg-red-50"
          >
            Quitar imagen
          </button>
          <button
            type="button"
            data-img-close
            class="rounded-full border border-marca-300 px-5 py-2 text-sm font-medium text-marca-700 transition hover:bg-marca-100"
          >
            Cerrar
          </button>
        </div>
      </div>
    </div>
  )}
</div>

<script>
  // Inicializa CADA campo de imagen del form de forma independiente (scoped al
  // root), así soporta varias imágenes en una misma página (panel de Contenido).
  function initOne(root: HTMLElement) {
    if (root.dataset.imgInit) return; // evita doble init (initial + after-swap)
    root.dataset.imgInit = "1";
    const file = root.querySelector<HTMLInputElement>('input[type="file"]');
    const hidden = root.querySelector<HTMLInputElement>("[data-img-hidden]");
    const nameEl = root.querySelector("[data-img-filename]");
    const modal = root.querySelector("[data-img-modal]");
    const openBtn = root.querySelector("[data-img-open]");
    const thumb = root.querySelector<HTMLImageElement>("[data-img-thumb]");
    const big = root.querySelector<HTMLImageElement>("[data-img-big]");
    const removeBtns = root.querySelectorAll<HTMLElement>("[data-img-remove]");

    const open = () => {
      if (!modal) return;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    };
    const close = () => {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    };

    if (file) {
      file.addEventListener("change", () => {
        const f = file.files && file.files[0];
        if (nameEl) nameEl.textContent = f ? f.name : "Ningún archivo seleccionado";
        if (f) {
          const url = URL.createObjectURL(f);
          if (thumb) thumb.src = url;
          if (big) big.src = url;
          removeBtns.forEach((b) => b.classList.remove("hidden"));
        }
        close();
      });
    }

    // Quitar imagen: vacía el hidden (al guardar queda sin imagen), limpia el
    // archivo elegido y oculta la miniatura. No sube nada.
    const quitar = () => {
      if (hidden) {
        hidden.value = "";
        hidden.dispatchEvent(new Event("input", { bubbles: true })); // marca el form como sucio
      }
      if (file) file.value = "";
      if (nameEl) nameEl.textContent = "Ningún archivo seleccionado";
      (openBtn as HTMLElement | null)?.classList.add("hidden");
      removeBtns.forEach((b) => b.classList.add("hidden"));
      close();
    };
    removeBtns.forEach((b) => b.addEventListener("click", quitar));

    if (openBtn) openBtn.addEventListener("click", open);
    if (modal) {
      root.querySelectorAll("[data-img-close]").forEach((b) =>
        b.addEventListener("click", close),
      );
      modal.addEventListener("click", (e) => {
        if (e.target === modal) close();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });
    }
  }

  function initImageFields() {
    document.querySelectorAll<HTMLElement>("[data-img-field]").forEach(initOne);
  }

  initImageFields();
  document.addEventListener("astro:after-swap", initImageFields);
</script>
