---
// Header sticky reutilizable para los editores del panel: barra con
// [← Volver | título centrado | (acciones) Guardar]. El botón Guardar vive
// fuera del <form> y lo envía vía form={formId}. Incluye estado del botón
// (Guardar / Guardando… / ✓ Guardado) y el aviso de cambios sin guardar.
// Se coloca en el slot "antetitulo" del AdminLayout (con ocultarTitulo).
interface Props {
  titulo: string;
  volverHref: string;
  volverLabel: string;
  formId: string; // id del <form> principal del editor
  guardado?: boolean; // true tras guardar (ej. ?ok=1) → muestra "✓ Guardado"
}
const { titulo, volverHref, volverLabel, formId, guardado = false } = Astro.props;
---

<div
  data-editor-header
  data-form-id={formId}
  class="sticky top-0 z-20 -mx-8 -mt-8 mb-6 flex items-center gap-3 border-b border-marca-100 bg-crema/95 px-8 py-3 backdrop-blur"
>
  <a
    href={volverHref}
    class="inline-flex shrink-0 items-center gap-1 rounded-full bg-marca-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-marca-700"
  >
    ← {volverLabel}
  </a>
  <h1 class="min-w-0 flex-1 truncate text-center text-base font-semibold text-marca-700 sm:text-lg">
    {titulo}
  </h1>
  <div class="flex shrink-0 items-center gap-2">
    <slot name="acciones" />
    <button
      data-btn-guardar
      type="submit"
      form={formId}
      class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-marca-500 px-5 py-2 text-sm font-medium text-white transition hover:bg-marca-600"
    >
      <svg
        data-tick
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class:list={["h-4 w-4", !guardado && "hidden"]}
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
      </svg>
      <span data-texto>{guardado ? "Guardado" : "Guardar"}</span>
    </button>
  </div>
</div>

<!-- Aviso de cambios sin guardar -->
<div data-modal-sin-guardar class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
  <div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl">
    <h2 class="text-lg font-semibold text-marca-900">Cambios sin guardar</h2>
    <p class="mt-2 text-sm text-marca-900/70">
      Hiciste cambios que todavía no guardaste. Si salís ahora, se van a perder.
    </p>
    <div class="mt-5 flex flex-wrap justify-end gap-3">
      <button type="button" data-salir class="rounded-full border border-marca-300 px-5 py-2 text-sm font-medium text-marca-700 transition hover:bg-marca-50">
        Salir sin guardar
      </button>
      <button type="button" data-seguir class="rounded-full bg-marca-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-marca-700">
        Seguir editando
      </button>
    </div>
  </div>
</div>

<script>
  function setupAdminEditorHeader() {
    const header = document.querySelector("[data-editor-header]") as HTMLElement | null;
    if (!header) return;
    const formId = header.dataset.formId;
    const form = formId ? (document.getElementById(formId) as HTMLFormElement | null) : null;
    if (!form) return;
    const modal = document.querySelector("[data-modal-sin-guardar]");
    const btnTexto = header.querySelector("[data-texto]");
    const btnTick = header.querySelector("[data-tick]");
    let dirty = false;
    let pendingHref: string | null = null;

    const marcarSucio = () => {
      dirty = true;
      if (btnTexto) btnTexto.textContent = "Guardar";
      btnTick?.classList.add("hidden");
    };
    form.addEventListener("input", marcarSucio);
    form.addEventListener("change", marcarSucio);
    form.addEventListener("submit", () => {
      dirty = false;
      if (btnTexto) btnTexto.textContent = "Guardando…";
      btnTick?.classList.add("hidden");
    });

    const abrir = () => { modal?.classList.remove("hidden"); modal?.classList.add("flex"); };
    const cerrar = () => { modal?.classList.add("hidden"); modal?.classList.remove("flex"); };

    document.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest("a[href]") as HTMLAnchorElement | null;
      if (!a || !dirty) return;
      const href = a.getAttribute("href");
      if (!href || href.startsWith("#") || a.target === "_blank") return;
      e.preventDefault();
      pendingHref = a.href;
      abrir();
    });

    modal?.querySelector("[data-seguir]")?.addEventListener("click", () => { pendingHref = null; cerrar(); });
    modal?.querySelector("[data-salir]")?.addEventListener("click", () => {
      dirty = false;
      cerrar();
      if (pendingHref) window.location.href = pendingHref;
    });
    modal?.addEventListener("click", (e) => { if (e.target === modal) { pendingHref = null; cerrar(); } });

    window.addEventListener("beforeunload", (e) => {
      if (!dirty) return;
      e.preventDefault();
      e.returnValue = "";
    });
  }

  setupAdminEditorHeader();
</script>
