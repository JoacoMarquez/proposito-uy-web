---
// Botón de favorito (corazón). Lleva los datos del producto en data-attributes
// para que el script global (FavoritosInit) lo guarde en localStorage al togglear.
// El estado visual (relleno/rojo) lo controla la clase is-fav vía global.css.
interface Props {
  slug: string;
  nombre: string;
  variante: string;
  imagen?: string;
  precioDesde: number;
  desde: boolean;
  /** "icon" = solo corazón (cards) · "full" = corazón + texto (detalle). */
  variante2?: "icon" | "full";
  class?: string;
}
const { slug, nombre, variante, imagen, precioDesde, desde, variante2 = "icon", class: extra = "" } = Astro.props;

const base =
  variante2 === "full"
    ? "fav-btn inline-flex items-center justify-center gap-2 rounded-full border border-marca-300 px-5 py-3 font-medium text-marca-700 hover:bg-marca-50"
    : "fav-btn rounded-full bg-white/90 p-2 text-marca-700 shadow-sm hover:bg-white";
---

<button
  type="button"
  data-fav-toggle
  data-slug={slug}
  data-nombre={nombre}
  data-variante={variante}
  data-imagen={imagen ?? ""}
  data-precio={precioDesde}
  data-desde={String(desde)}
  aria-pressed="false"
  aria-label="Agregar a favoritos"
  class:list={[base, extra]}
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="fav-icon h-6 w-6">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
  </svg>
  {variante2 === "full" && (
    <>
      <span class="fav-label-add">Agregar a favoritos</span>
      <span class="fav-label-remove">En favoritos</span>
    </>
  )}
</button>
