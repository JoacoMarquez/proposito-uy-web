---
// Convierte fracciones escritas como "1/3" en su glifo "⅓" mientras se tipea,
// dentro del/los textarea cuyo id se pasa en `target` (uno o varios, separados
// por coma). Pensado para el editor de recetas (ingredientes, procedimiento).
interface Props {
  target: string;
}
const { target } = Astro.props;
const ids = target.split(",").map((s) => s.trim());
---

<span data-autofraccion={ids.join(",")} hidden></span>

<script>
  const MAPA: Record<string, string> = {
    "1/2": "½", "1/3": "⅓", "2/3": "⅔",
    "1/4": "¼", "3/4": "¾",
    "1/5": "⅕", "2/5": "⅖", "3/5": "⅗", "4/5": "⅘",
    "1/6": "⅙", "5/6": "⅚",
    "1/8": "⅛", "3/8": "⅜", "5/8": "⅝", "7/8": "⅞",
  };
  // Una fracción "a/b" al final del texto previo al cursor, no precedida por
  // otro dígito o punto (para no romper "11/3" ni "1.1/2").
  const RE = /(?<![\d.])(\d\/\d)$/;

  function convertir(ta: HTMLTextAreaElement) {
    const pos = ta.selectionStart ?? ta.value.length;
    const m = ta.value.slice(0, pos).match(RE);
    if (!m) return;
    const glifo = MAPA[m[1]];
    if (!glifo) return;
    const start = pos - m[1].length;
    ta.value = ta.value.slice(0, start) + glifo + ta.value.slice(pos);
    ta.selectionStart = ta.selectionEnd = start + glifo.length;
  }

  function setup(marker: HTMLElement) {
    if (marker.dataset.init) return;
    marker.dataset.init = "1";
    (marker.dataset.autofraccion ?? "").split(",").forEach((id) => {
      const ta = document.getElementById(id.trim()) as HTMLTextAreaElement | null;
      if (ta) ta.addEventListener("input", () => convertir(ta));
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-autofraccion]").forEach(setup);
  }
  init();
  document.addEventListener("astro:after-swap", init);
</script>
