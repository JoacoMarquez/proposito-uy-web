{
  // Configuración del Worker de Cloudflare para la web de Propósito UY.
  // nodejs_compat habilita node:crypto (scrypt del panel) y process.env.
  // El name debe coincidir con el servicio conectado a Git en Cloudflare
  // (Workers Builds) para no crear Workers duplicados.
  "name": "proposito-uy-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2025-05-21",
  "compatibility_flags": ["nodejs_compat"],
  // Conserva las variables/secrets cargadas desde el dashboard al desplegar.
  // Sin esto, cada deploy de Workers Builds borra las variables (tipo Text) que
  // no estén en este archivo — por eso desaparecían BREVO_LIST_ID, RESEND_API_KEY,
  // etc. Los secrets se mantienen, pero con keep_vars protegemos todo.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "proposito-fotos" }
  ]
}
