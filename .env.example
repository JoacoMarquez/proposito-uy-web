# Base de datos (Neon Postgres) — crear gratis en https://neon.tech y pegar la cadena aquí.
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Email donde Propósito recibe el aviso/respaldo de cada nuevo pedido.
# Los mails de pedido (al cliente y este aviso) se envían por Brevo — ver abajo.
MAIL_ADMIN=""

# Autenticación del panel /admin (generar con: openssl rand -base64 32)
AUTH_SECRET=""
# Email del administrador (la clienta) para el primer acceso al panel.
ADMIN_EMAIL=""

# Brevo: newsletter (lista de contactos) + mails transaccionales
# (confirmación de pedido, aviso al admin, reseteo de contraseña).
BREVO_API_KEY=""
BREVO_LIST_ID=""

# Remitente para los mails transaccionales por Brevo (debe estar verificado en Brevo).
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Propósito UY"
