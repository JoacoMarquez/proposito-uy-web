# Base de datos (Neon Postgres) — crear gratis en https://neon.tech y pegar la cadena aquí.
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Envío de mails de confirmación de pedido (https://resend.com)
RESEND_API_KEY=""
# Remitente de los mails (debe ser de un dominio verificado en Resend).
# Si no se define, usa el sandbox de Resend (onboarding@resend.dev).
MAIL_FROM="Propósito UY <pedidos@propositouy.com.uy>"
# Email donde Propósito recibe el aviso de cada nuevo pedido.
MAIL_ADMIN=""

# Autenticación del panel /admin (generar con: openssl rand -base64 32)
AUTH_SECRET=""
# Email del administrador (la clienta) para el primer acceso al panel.
ADMIN_EMAIL=""

# Brevo (newsletter): sincroniza suscriptores a una lista de contactos.
BREVO_API_KEY=""
BREVO_LIST_ID=""
